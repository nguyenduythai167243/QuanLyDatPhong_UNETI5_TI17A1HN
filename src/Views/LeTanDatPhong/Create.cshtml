@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình tạo đặt phòng trực tiếp tại quầy của Lễ tân (Walk-in Reservation Terminal)
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.DatPhong

@{
    ViewData["Title"] = "Đặt Phòng Tại Quầy (Walk-in) - Lễ Tân";
    ViewData["FluidLayout"] = true;
}

<div class="py-2">
    <!-- Hero Banner -->
    <div class="letan-hero mb-3 py-3 px-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                    <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1">
                        Quầy tiếp tân (Front Desk)
                    </span>
                    <span class="badge bg-success bg-opacity-50 text-white">Khách vãng lai / Walk-in</span>
                </div>
                <h2 class="letan-hero-title mb-1">
                    <i class="bi bi-plus-circle-fill text-warning me-2"></i>ĐẶT PHÒNG TRỰC TIẾP TẠI QUẦY
                </h2>
                <div class="letan-hero-sub">
                    Tạo đơn đặt phòng mới dành cho khách đến trực tiếp hoặc đặt qua tổng đài |
                    <strong>Sinh viên:</strong> Nguyễn Duy Thái (23103100052)
                </div>
            </div>
            <div>
                <a asp-action="KiemTraCongSuat" class="btn-hero-action btn-glass">
                    <i class="bi bi-pie-chart-fill text-info"></i> Kiểm tra công suất phòng
                </a>
            </div>
        </div>
    </div>

    <!-- Form và Live Preview -->
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Cột trái: Form nhập liệu -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-3">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Thông tin đăng ký đặt phòng
                    </h5>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <!-- 1. Chọn khách hàng -->
                    <div class="mb-3">
                        <label asp-for="MaKhachHang" class="letan-label">
                            <i class="bi bi-person-fill"></i> Khách hàng nhận phòng <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaKhachHang" class="letan-select w-100" asp-items="ViewBag.MaKhachHang" required>
                            <option value="">-- Chọn khách hàng trong hệ thống --</option>
                        </select>
                        <span asp-validation-for="MaKhachHang" class="text-danger small"></span>
                        <div class="form-text small text-muted">
                            <i class="bi bi-info-circle me-1"></i> Nếu là khách mới, vui lòng vào <a asp-controller="QuanLyKhachHang" asp-action="Create" target="_blank" class="fw-bold text-primary">Quản lý Khách hàng</a> để đăng ký hồ sơ trước.
                        </div>
                    </div>

                    <!-- 2. Chọn phòng sẵn sàng -->
                    <div class="mb-3">
                        <label asp-for="MaPhong" class="letan-label">
                            <i class="bi bi-door-open-fill"></i> Phòng phân bổ (Chỉ hiển thị phòng Sẵn sàng) <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaPhong" class="letan-select w-100" asp-items="ViewBag.MaPhong" required>
                            <option value="">-- Chọn phòng trống sẵn sàng --</option>
                        </select>
                        <span asp-validation-for="MaPhong" class="text-danger small"></span>
                    </div>

                    <!-- 3. Ngày nhận & Ngày trả -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NgayNhanPhong" class="letan-label">
                                <i class="bi bi-box-arrow-in-right text-success"></i> Ngày nhận phòng (Check-in) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NgayNhanPhong" type="date" class="letan-select w-100" value="@Model.NgayNhanPhong.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="NgayNhanPhong" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NgayTraPhong" class="letan-label">
                                <i class="bi bi-box-arrow-left text-danger"></i> Ngày trả phòng (Check-out) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NgayTraPhong" type="date" class="letan-select w-100" value="@Model.NgayTraPhong.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="NgayTraPhong" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 4. Số người -->
                    <div class="mb-3">
                        <label asp-for="SoNguoi" class="letan-label">
                            <i class="bi bi-people-fill"></i> Số lượng khách lưu trú <span class="text-danger">*</span>
                        </label>
                        <input asp-for="SoNguoi" type="number" min="1" max="10" class="letan-select w-100" placeholder="Nhập số lượng khách..." required />
                        <span asp-validation-for="SoNguoi" class="text-danger small"></span>
                    </div>

                    <!-- 5. Yêu cầu đặc biệt -->
                    <div class="mb-3">
                        <label asp-for="YeuCauDacBiet" class="letan-label">
                            <i class="bi bi-stars"></i> Yêu cầu đặc biệt của khách (nếu có)
                        </label>
                        <textarea asp-for="YeuCauDacBiet" class="letan-select w-100" rows="2" placeholder="Ví dụ: Phòng không hút thuốc, kê thêm giường phụ, phòng tầng cao yên tĩnh..."></textarea>
                        <span asp-validation-for="YeuCauDacBiet" class="text-danger small"></span>
                    </div>

                    <!-- 6. Ghi chú của lễ tân -->
                    <div class="mb-3">
                        <label asp-for="GhiChuLeTan" class="letan-label">
                            <i class="bi bi-chat-left-dots-fill"></i> Ghi chú tiếp nhận của Lễ tân
                        </label>
                        <textarea asp-for="GhiChuLeTan" class="letan-select w-100" rows="2" placeholder="Ví dụ: Khách đặt trực tiếp tại quầy lúc @DateTime.Now.ToString("HH:mm dd/MM"). Đã nhận tiền cọc hoặc thanh toán sau..."></textarea>
                        <span asp-validation-for="GhiChuLeTan" class="text-danger small"></span>
                    </div>

                    <!-- Hidden input for total money calculated dynamically -->
                    <input type="hidden" asp-for="TongTienDuKien" id="TongTienDuKien" />

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Xác nhận Tạo đơn đặt phòng
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Live Quotation & Booking Summary Preview -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-calculator text-primary me-1"></i> Báo giá dự kiến
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Tự động tính</span>
                    </div>

                    <div class="p-3 rounded-3 mb-3" style="background: linear-gradient(135deg, #eef2ff 0%, #f1f5f9 100%);">
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Đơn giá phòng:</span>
                            <strong class="text-dark" id="preview-giaphong">0 đ/đêm</strong>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Thời gian lưu trú:</span>
                            <strong class="text-primary" id="preview-sodem">1 đêm</strong>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark small text-uppercase">Tổng dự kiến:</span>
                            <span class="fs-4 fw-bold text-danger" id="preview-tongtien">0 VNĐ</span>
                        </div>
                    </div>

                    <div class="small text-muted mb-3">
                        <div class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-success me-1"></i>Quy chuẩn tiếp nhận UNETI:</div>
                        <ul class="ps-3 mb-0" style="font-size: 0.8rem; line-height: 1.6;">
                            <li>Giờ nhận phòng tiêu chuẩn: <strong>14:00</strong></li>
                            <li>Giờ trả phòng tiêu chuẩn: <strong>12:00</strong></li>
                            <li>Hệ thống tự động kiểm tra trùng lịch phòng (LINQ) trước khi lưu.</li>
                            <li>Đơn mới tạo sẽ ở trạng thái <strong>Chờ xác nhận</strong> để Lễ tân đối soát.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>