@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình làm thủ tục nhận phòng (Check-in) và cập nhật thời gian thực tế
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.XuLyDatPhongViewModel

@{
    ViewData["Title"] = $"Nhận phòng - Đặt phòng #{Model.DatPhong.MaDatPhong}";
    var dp = Model.DatPhong;
}

<div class="container py-4" style="max-width: 750px;">
    <div class="card border-0 shadow-sm border-start border-primary border-4">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold text-primary">
                <i class="bi bi-door-open-fill"></i> LÀM THỦ TỤC NHẬN PHÒNG (CHECK-IN)
            </h4>
            <div class="small text-muted">
                Module 4 - Sinh viên thực hiện: Nguyễn Duy Thái (MSV: 23103100052)
            </div>
        </div>
        <div class="card-body p-4">
            <!-- Thông báo TempData -->
            @if (TempData["ThongBaoCanhBao"] != null)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ThongBaoCanhBao"]
                </div>
            }

            <div class="alert alert-primary bg-opacity-10 border border-primary mb-4">
                <div class="row">
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Đơn đặt:</span>
                        <strong class="fs-5">#@dp.MaDatPhong</strong>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Khách hàng nhận phòng:</span>
                        <strong class="fs-5 text-dark">@(dp.KhachHang?.HoTen ?? "N/A")</strong>
                        <div class="small text-muted">CMND/CCCD: @(dp.KhachHang?.SoGiayToTuyThan ?? "N/A") | SĐT: @(dp.KhachHang?.SoDienThoai ?? "N/A")</div>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Phòng giao cho khách:</span>
                        <span class="badge bg-primary fs-5">Phòng @(dp.Phong?.SoPhong ?? "N/A")</span>
                        <span class="text-muted ms-1">(@(dp.Phong?.LoaiPhong?.TenLoaiPhong ?? "N/A") - Tầng @(dp.Phong?.Tang ?? 1))</span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Ngày nhận dự kiến:</span>
                        <strong>@dp.NgayNhanPhong.ToString("dd/MM/yyyy")</strong>
                        <span class="text-muted">đến</span>
                        <strong>@dp.NgayTraPhong.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="col-12 mt-2 pt-2 border-top">
                        <span class="text-muted">Thời điểm nhận phòng thực tế sẽ ghi nhận:</span>
                        <strong class="text-success fs-5">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                    </div>
                </div>
            </div>

            <form asp-action="NhanPhong" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@dp.MaDatPhong" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi chú tiếp nhận (bàn giao thẻ từ, xác nhận giấy tờ tùy thân...):</label>
                    <textarea name="ghiChu" class="form-control" rows="3" placeholder="Ví dụ: Đã đối chiếu CCCD, bàn giao chìa khóa và thẻ từ phòng @(dp.Phong?.SoPhong)..."></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" onclick="return confirm('Xác nhận hoàn tất thủ tục nhận phòng cho khách hàng?');">
                        <i class="bi bi-check2-circle"></i> Xác nhận Hoàn tất Nhận phòng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>