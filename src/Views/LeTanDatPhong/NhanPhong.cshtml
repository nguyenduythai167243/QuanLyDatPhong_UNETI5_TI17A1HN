@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình làm thủ tục nhận phòng (Check-in) và cập nhật thời gian thực tế
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.XuLyDatPhongViewModel

@{
    ViewData["Title"] = $"Thủ Tục Nhận Phòng - Đặt Phòng #{Model.DatPhong.MaDatPhong} - Lễ Tân";
    var dp = Model.DatPhong;
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Nút quay lại -->
    <div class="mb-3">
        <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết đặt phòng
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="py-4 px-4 text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2">
                        <i class="bi bi-door-open-fill me-1"></i> Thủ tục lưu trú khách sạn
                    </span>
                    <h3 class="mb-0 fw-bold">
                        LÀM THỦ TỤC NHẬN PHÒNG (CHECK-IN)
                    </h3>
                </div>
                <span class="badge bg-white text-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                    Đơn #@dp.MaDatPhong
                </span>
            </div>
            <div class="small opacity-75 mt-2">
                Module 4 - Sinh viên thực hiện: Nguyễn Duy Thái (MSV: 23103100052)
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Thông báo TempData -->
            @if (TempData["ThongBaoCanhBao"] != null)
            {
                <div class="alert alert-warning border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill fs-5"></i>
                    <div>@TempData["ThongBaoCanhBao"]</div>
                </div>
            }

            <!-- Thông tin tiếp nhận -->
            <div class="p-4 rounded-4 mb-4 border" style="background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small fw-bold text-uppercase">Khách hàng nhận phòng:</div>
                        <div class="fs-5 fw-bold text-dark mt-1">@(dp.KhachHang?.HoTen ?? "N/A")</div>
                        <div class="small text-muted">
                            <i class="bi bi-card-text me-1"></i>CCCD: <strong>@(dp.KhachHang?.SoGiayToTuyThan ?? "N/A")</strong> | SĐT: <strong>@(dp.KhachHang?.SoDienThoai ?? "N/A")</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small fw-bold text-uppercase">Phòng bàn giao:</div>
                        <div class="mt-1">
                            <span class="room-tag fs-5">
                                <i class="bi bi-key-fill text-primary"></i> Phòng @(dp.Phong?.SoPhong ?? "N/A")
                            </span>
                            <span class="text-secondary small ms-2 fw-semibold">
                                (@(dp.Phong?.LoaiPhong?.TenLoaiPhong ?? "N/A") - Tầng @(dp.Phong?.Tang ?? 1))
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6 pt-2 border-top">
                        <div class="text-muted small fw-bold text-uppercase">Khoảng thời gian đăng ký:</div>
                        <div class="fw-semibold text-dark mt-1">
                            @dp.NgayNhanPhong.ToString("dd/MM/yyyy") &rarr; @dp.NgayTraPhong.ToString("dd/MM/yyyy")
                            <span class="badge bg-primary-subtle text-primary ms-1">@Model.SoDem đêm</span>
                        </div>
                    </div>

                    <div class="col-md-6 pt-2 border-top">
                        <div class="text-muted small fw-bold text-uppercase">Ghi nhận thời điểm Check-in thực tế:</div>
                        <div class="fs-5 fw-bold text-success mt-1">
                            <i class="bi bi-clock-history me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="NhanPhong" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@dp.MaDatPhong" />

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">
                        <i class="bi bi-journal-check text-primary me-1"></i> Ghi chú tiếp nhận (bàn giao thẻ từ, xác nhận giấy tờ tùy thân...):
                    </label>
                    <textarea name="ghiChu" class="letan-select w-100" rows="3" placeholder="Ví dụ: Đã đối chiếu CCCD chính chủ, bàn giao thẻ từ phòng @(dp.Phong?.SoPhong) và hướng dẫn nội quy khách sạn...">@Model.GhiChuLeTan</textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold rounded-pill shadow-sm" onclick="return confirm('Xác nhận hoàn tất thủ tục nhận phòng cho khách hàng?');">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận Hoàn tất Nhận phòng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>