@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình chi tiết đặt phòng, kiểm tra điều kiện nghiệp vụ LINQ và quản lý luồng trạng thái
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.XuLyDatPhongViewModel

@{
    ViewData["Title"] = $"Chi tiết Đặt phòng #{Model.DatPhong.MaDatPhong}";
    var dp = Model.DatPhong;
    var kt = Model.KiemTra;
}

<div class="container py-3">
    <!-- Tiêu đề & Điều hướng -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="text-primary fw-bold mb-1">
                <i class="bi bi-file-earmark-text"></i> CHI TIẾT ĐẶT PHÒNG #@dp.MaDatPhong
            </h3>
            <div class="text-muted small">
                <span class="badge bg-primary">Module 4</span>
                <strong>Sinh viên phụ trách:</strong> Nguyễn Duy Thái - <strong>MSV:</strong> 23103100052
            </div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ThongBaoThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ThongBaoLoi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin đặt phòng & khách hàng -->
        <div class="col-lg-7">
            <!-- Thông tin chính -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-info-circle text-primary"></i> Thông tin đặt phòng
                    </h5>
                    <div>
                        @switch (dp.TrangThai)
                        {
                            case "Chờ xác nhận":
                                <span class="badge bg-warning text-dark fs-6">Chờ xác nhận</span>
                                break;
                            case "Đã xác nhận":
                                <span class="badge bg-info text-dark fs-6">Đã xác nhận</span>
                                break;
                            case "Đã nhận phòng":
                                <span class="badge bg-primary fs-6">Đã nhận phòng</span>
                                break;
                            case "Đã trả phòng":
                                <span class="badge bg-success fs-6">Đã trả phòng</span>
                                break;
                            case "Từ chối":
                                <span class="badge bg-secondary fs-6">Từ chối</span>
                                break;
                            case "Đã hủy":
                                <span class="badge bg-danger fs-6">Đã hủy</span>
                                break;
                            default:
                                <span class="badge bg-secondary fs-6">@dp.TrangThai</span>
                                break;
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Mã đặt phòng:</div>
                        <div class="col-sm-8 fw-bold">#@dp.MaDatPhong</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Thời điểm đặt:</div>
                        <div class="col-sm-8">@dp.NgayDat.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Phòng đăng ký:</div>
                        <div class="col-sm-8">
                            <span class="badge bg-primary fs-6">Phòng @(dp.Phong?.SoPhong ?? "N/A")</span>
                            <span class="text-muted ms-2">(@(dp.Phong?.LoaiPhong?.TenLoaiPhong ?? "N/A") - Tầng @(dp.Phong?.Tang ?? 1))</span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Thời gian lưu trú:</div>
                        <div class="col-sm-8">
                            <div><strong>Nhận:</strong> @dp.NgayNhanPhong.ToString("dd/MM/yyyy") (14:00)</div>
                            <div><strong>Trả:</strong> @dp.NgayTraPhong.ToString("dd/MM/yyyy") (12:00)</div>
                            <div class="text-primary fw-bold">Thời lượng: @Model.SoDem đêm</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Số lượng khách:</div>
                        <div class="col-sm-8">@dp.SoNguoi người (Sức chứa tối đa: @(dp.Phong?.SucChua ?? 0) người)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Tổng tiền dự kiến:</div>
                        <div class="col-sm-8 fs-5 fw-bold text-danger">@dp.TongTienDuKien.ToString("N0") VNĐ</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Yêu cầu đặc biệt:</div>
                        <div class="col-sm-8 fst-italic">@(string.IsNullOrWhiteSpace(dp.YeuCauDacBiet) ? "Không có" : dp.YeuCauDacBiet)</div>
                    </div>

                    <hr />

                    <!-- Quá trình xử lý thực tế -->
                    <h6 class="fw-bold text-secondary mb-3">Lịch sử thực tế & Xử lý:</h6>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Ngày nhận thực tế:</div>
                        <div class="col-sm-8">@(dp.NgayNhanThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa làm thủ tục nhận phòng")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Ngày trả thực tế:</div>
                        <div class="col-sm-8">@(dp.NgayTraThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa làm thủ tục trả phòng")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Ngày xử lý đơn:</div>
                        <div class="col-sm-8">@(dp.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Ghi chú của Lễ tân:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@(string.IsNullOrWhiteSpace(dp.GhiChuLeTan) ? "Không có" : dp.GhiChuLeTan)</div>
                    </div>
                </div>
            </div>

            <!-- Thông tin khách hàng -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-person text-success"></i> Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Họ và tên:</div>
                        <div class="col-sm-8 fw-bold">@(dp.KhachHang?.HoTen ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Số điện thoại:</div>
                        <div class="col-sm-8">@(dp.KhachHang?.SoDienThoai ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Email:</div>
                        <div class="col-sm-8">@(dp.KhachHang?.Email ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Giấy tờ tùy thân:</div>
                        <div class="col-sm-8">@(dp.KhachHang?.SoGiayToTuyThan ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Địa chỉ:</div>
                        <div class="col-sm-8">@(dp.KhachHang?.DiaChi ?? "N/A")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Trạng thái tài khoản:</div>
                        <div class="col-sm-8">
                            @if (dp.KhachHang?.TrangThai == true)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Bị khóa / Ngừng hoạt động</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng kiểm tra điều kiện LINQ & Nút thao tác chuyển trạng thái -->
        <div class="col-lg-5">
            <!-- 1. Bảng kiểm tra điều kiện nghiệp vụ tự động (Checklist LINQ) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-shield-check text-primary"></i> Kiểm tra điều kiện nghiệp vụ (LINQ)
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-3">
                        <!-- Trạng thái phòng -->
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <strong>Phòng sẵn sàng</strong>
                                <div class="small text-muted">Trạng thái hiện tại: @(kt.TrangThaiHienTaiCuaPhong ?? "Không rõ")</div>
                            </div>
                            @if (kt.PhongSanSang)
                            {
                                <span class="badge bg-success">Thỏa mãn</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Không sẵn sàng</span>
                            }
                        </li>

                        <!-- Trạng thái khách hàng -->
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <strong>Khách hàng hoạt động</strong>
                                <div class="small text-muted">Tài khoản chưa bị khóa</div>
                            </div>
                            @if (kt.KhachHangHoatDong)
                            {
                                <span class="badge bg-success">Thỏa mãn</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Bị khóa</span>
                            }
                        </li>

                        <!-- Trùng lịch phòng -->
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <strong>Kiểm tra trùng lịch (Overlap)</strong>
                                <div class="small text-muted">Không trùng đơn đã xác nhận / đang ở</div>
                            </div>
                            @if (!kt.CoBiTrungLich)
                            {
                                <span class="badge bg-success">Không trùng</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Trùng lịch!</span>
                            }
                        </li>

                        <!-- Kiểm soát công suất phòng -->
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <strong>Kiểm soát công suất loại phòng</strong>
                                <div class="small text-muted">
                                    Đã kín: @kt.SoPhongDaKinLichTrongKhoang / @kt.TongPhongSanSangCuaLoai phòng
                                </div>
                            </div>
                            @if (!kt.LoaiPhongBiKinLich)
                            {
                                <span class="badge bg-success">Còn phòng</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Kín lịch!</span>
                            }
                        </li>

                        <!-- Đến ngày nhận phòng -->
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <strong>Ngày nhận phòng</strong>
                                <div class="small text-muted">Ngày nhận: @dp.NgayNhanPhong.ToString("dd/MM/yyyy")</div>
                            </div>
                            @if (kt.DaDenNgayNhan)
                            {
                                <span class="badge bg-primary">Đã đến ngày</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa tới ngày</span>
                            }
                        </li>
                    </ul>

                    <!-- Chi tiết cảnh báo / lỗi nếu có -->
                    @if (kt.DanhSachLoi.Any())
                    {
                        <div class="alert alert-danger py-2 small mb-2">
                            <strong>Các vi phạm nghiệp vụ:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var err in kt.DanhSachLoi)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (kt.DanhSachCanhBao.Any())
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            <strong>Cảnh báo:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var warn in kt.DanhSachCanhBao)
                                {
                                    <li>@warn</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Thao tác xử lý nghiệp vụ theo luồng trạng thái (State Machine) -->
            <div class="card border-0 shadow-sm border-start border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-gear-wide-connected text-primary"></i> Xử lý trạng thái Lễ tân
                    </h5>
                </div>
                <div class="card-body">
                    @if (dp.TrangThai == "Chờ xác nhận")
                    {
                        <!-- TRẠNG THÁI 1: CHỜ XÁC NHẬN -->
                        <div class="mb-3">
                            <p class="small text-muted mb-2">
                                Đơn đặt phòng đang chờ Lễ tân xem xét điều kiện để chuyển trạng thái sang <strong>Đã xác nhận</strong> hoặc <strong>Từ chối</strong>.
                            </p>
                            <div class="d-grid gap-2">
                                <a asp-action="XacNhan" asp-route-id="@dp.MaDatPhong" class="btn btn-success fw-bold">
                                    <i class="bi bi-check-circle"></i> Tiến hành Xác nhận đặt phòng
                                </a>
                                <a asp-action="TuChoi" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-danger">
                                    <i class="bi bi-x-circle"></i> Từ chối đặt phòng
                                </a>
                            </div>
                        </div>
                    }
                    else if (dp.TrangThai == "Đã xác nhận")
                    {
                        <!-- TRẠNG THÁI 2: ĐÃ XÁC NHẬN -->
                        <div class="mb-3">
                            @if (Model.CoTheNhanPhong)
                            {
                                <p class="small text-success mb-2">
                                    <i class="bi bi-check-circle"></i> Đã đến ngày nhận phòng. Lễ tân có thể làm thủ tục check-in cho khách hàng!
                                </p>
                                <a asp-action="NhanPhong" asp-route-id="@dp.MaDatPhong" class="btn btn-primary btn-lg w-100 fw-bold mb-2">
                                    <i class="bi bi-door-open-fill"></i> Làm thủ tục Nhận phòng (Check-in)
                                </a>
                            }
                            else
                            {
                                <div class="alert alert-secondary small mb-2">
                                    <i class="bi bi-clock"></i> Chưa đến ngày nhận phòng (@dp.NgayNhanPhong.ToString("dd/MM/yyyy")). Chỉ được làm thủ tục nhận phòng khi đã đến ngày nhận theo quy định.
                                </div>
                            }

                            @if (Model.LaDonQuaHan)
                            {
                                <div class="alert alert-danger small mb-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Đã quá ngày nhận phòng nhưng khách chưa đến nhận phòng (No-show).
                                </div>
                                <form asp-action="HuyQuaHan" asp-route-id="@dp.MaDatPhong" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn đặt phòng quá hạn này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-trash"></i> Hủy đơn quá hạn (No-show)
                                    </button>
                                </form>
                            }
                        </div>
                    }
                    else if (dp.TrangThai == "Đã nhận phòng")
                    {
                        <!-- TRẠNG THÁI 3: ĐÃ NHẬN PHÒNG -->
                        <div class="mb-3">
                            <p class="small text-primary mb-2">
                                Khách hàng đang lưu trú tại khách sạn từ lúc @(dp.NgayNhanThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "N/A").
                            </p>
                            <div class="d-grid gap-2">
                                <a asp-action="TraPhong" asp-route-id="@dp.MaDatPhong" class="btn btn-warning btn-lg text-dark fw-bold">
                                    <i class="bi bi-box-arrow-left"></i> Làm thủ tục Trả phòng (Check-out)
                                </a>
                                <a asp-controller="DichVuPhatSinh" asp-action="Create" class="btn btn-outline-primary">
                                    <i class="bi bi-plus-circle"></i> Ghi nhận Dịch vụ phát sinh (Module 5)
                                </a>
                            </div>
                        </div>
                    }
                    else if (dp.TrangThai == "Đã trả phòng")
                    {
                        <!-- TRẠNG THÁI 4: ĐÃ TRẢ PHÒNG -->
                        <div class="alert alert-success mb-3">
                            <i class="bi bi-check2-all"></i> Đơn đặt phòng đã hoàn tất trả phòng lúc @(dp.NgayTraThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "N/A").
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="HoaDon" asp-action="Index" class="btn btn-outline-success">
                                <i class="bi bi-receipt"></i> Quản lý Hóa đơn thanh toán (Module 5)
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- TRẠNG THÁI 5 & 6: TỪ CHỐI / ĐÃ HỦY -->
                        <div class="alert alert-secondary mb-0">
                            <i class="bi bi-x-octagon"></i> Đơn đặt phòng này ở trạng thái <strong>@dp.TrangThai</strong> và đã kết thúc. Không thể thay đổi luồng trạng thái.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
