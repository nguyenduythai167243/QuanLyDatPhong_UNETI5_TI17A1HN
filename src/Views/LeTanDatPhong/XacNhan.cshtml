@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình Xác nhận đặt phòng với kiểm tra điều kiện tự động bằng LINQ
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.XuLyDatPhongViewModel

@{
    ViewData["Title"] = $"Xác nhận Đặt phòng #{Model.DatPhong.MaDatPhong} - Lễ Tân";
    var dp = Model.DatPhong;
    var kt = Model.KiemTra;
}

<div class="container py-4" style="max-width: 900px;">
    <!-- Nút quay lại -->
    <div class="mb-3">
        <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết đặt phòng
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="py-4 px-4 text-white" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2">
                        <i class="bi bi-shield-check me-1"></i> Nghiệp vụ duyệt phòng
                    </span>
                    <h3 class="mb-0 fw-bold">
                        XÁC NHẬN ĐẶT PHÒNG #@dp.MaDatPhong
                    </h3>
                </div>
                <span class="badge bg-white text-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                    Phòng @(dp.Phong?.SoPhong ?? "---")
                </span>
            </div>
            <div class="small opacity-75 mt-2">
                Module 4 - Sinh viên thực hiện: Nguyễn Duy Thái (MSV: 23103100052)
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Thông báo TempData -->
            @if (TempData["ThongBaoLoi"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["ThongBaoLoi"]</div>
                </div>
            }

            <!-- Tóm tắt thông tin đặt phòng -->
            <div class="p-4 rounded-4 mb-4 border" style="background: #f8fafc;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small fw-bold text-uppercase">Khách hàng đăng ký:</div>
                        <div class="fs-5 fw-bold text-dark mt-1">@(dp.KhachHang?.HoTen ?? "N/A")</div>
                        <div class="small text-muted">
                            <i class="bi bi-telephone text-primary me-1"></i>@(dp.KhachHang?.SoDienThoai ?? "N/A") | CCCD: @(dp.KhachHang?.SoGiayToTuyThan ?? "N/A")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small fw-bold text-uppercase">Phòng phân bổ:</div>
                        <div class="mt-1">
                            <span class="room-tag fs-6">
                                <i class="bi bi-key-fill text-primary"></i> Phòng @(dp.Phong?.SoPhong ?? "N/A")
                            </span>
                            <span class="text-secondary small ms-2 fw-semibold">
                                (@(dp.Phong?.LoaiPhong?.TenLoaiPhong ?? "N/A"))
                            </span>
                        </div>
                        <div class="small text-muted mt-1">
                            Giá niêm yết: <strong>@(dp.Phong?.GiaMotDem.ToString("N0") ?? "0") đ/đêm</strong>
                        </div>
                    </div>
                    <div class="col-md-6 pt-2 border-top">
                        <div class="text-muted small fw-bold text-uppercase">Khoảng thời gian lưu trú:</div>
                        <div class="fw-semibold text-dark mt-1">
                            @dp.NgayNhanPhong.ToString("dd/MM/yyyy") &rarr; @dp.NgayTraPhong.ToString("dd/MM/yyyy")
                            <span class="badge bg-primary-subtle text-primary ms-1">@Model.SoDem đêm</span>
                        </div>
                    </div>
                    <div class="col-md-6 pt-2 border-top">
                        <div class="text-muted small fw-bold text-uppercase">Tổng tiền dự kiến:</div>
                        <div class="fs-4 fw-bold text-danger mt-1">
                            @dp.TongTienDuKien.ToString("N0") <span class="fs-6 text-muted">VNĐ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bảng kết quả kiểm tra điều kiện nghiệp vụ LINQ -->
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success"></i> Kết quả thẩm định điều kiện (LINQ Check):
            </h5>

            <div class="linq-rule-list mb-4">
                <div class="linq-rule-row">
                    <div class="linq-rule-info">
                        <div class="linq-rule-icon @(kt.PhongSanSang ? "linq-rule-pass" : "linq-rule-fail")">
                            <i class="bi @(kt.PhongSanSang ? "bi-check-lg" : "bi-x-lg")"></i>
                        </div>
                        <div>
                            <strong class="text-dark small">1. Phòng tồn tại và ở trạng thái Sẵn sàng</strong>
                            <div class="text-muted small" style="font-size: 0.75rem;">Hiện tại: @(kt.TrangThaiHienTaiCuaPhong ?? "Không rõ")</div>
                        </div>
                    </div>
                    <span class="badge @(kt.PhongSanSang ? "bg-success" : "bg-danger")">
                        @(kt.PhongSanSang ? "Đạt chuẩn" : "Không sẵn sàng")
                    </span>
                </div>

                <div class="linq-rule-row">
                    <div class="linq-rule-info">
                        <div class="linq-rule-icon @(kt.KhachHangHoatDong ? "linq-rule-pass" : "linq-rule-fail")">
                            <i class="bi @(kt.KhachHangHoatDong ? "bi-check-lg" : "bi-x-lg")"></i>
                        </div>
                        <div>
                            <strong class="text-dark small">2. Khách hàng đang hoạt động bình thường</strong>
                            <div class="text-muted small" style="font-size: 0.75rem;">Tài khoản không bị khóa</div>
                        </div>
                    </div>
                    <span class="badge @(kt.KhachHangHoatDong ? "bg-success" : "bg-danger")">
                        @(kt.KhachHangHoatDong ? "Hợp lệ" : "Bị khóa")
                    </span>
                </div>

                <div class="linq-rule-row">
                    <div class="linq-rule-info">
                        <div class="linq-rule-icon @(!kt.CoBiTrungLich ? "linq-rule-pass" : "linq-rule-fail")">
                            <i class="bi @(!kt.CoBiTrungLich ? "bi-check-lg" : "bi-exclamation-triangle")"></i>
                        </div>
                        <div>
                            <strong class="text-dark small">3. Không trùng lịch lưu trú với đơn khác (Overlap)</strong>
                            <div class="text-muted small" style="font-size: 0.75rem;">Kiểm tra LINQ đối soát buồng phòng</div>
                        </div>
                    </div>
                    <span class="badge @(!kt.CoBiTrungLich ? "bg-success" : "bg-danger")">
                        @(!kt.CoBiTrungLich ? "Không trùng" : $"Trùng {kt.DanhSachTrungLich.Count} đơn")
                    </span>
                </div>

                <div class="linq-rule-row">
                    <div class="linq-rule-info">
                        <div class="linq-rule-icon @(!kt.LoaiPhongBiKinLich ? "linq-rule-pass" : "linq-rule-fail")">
                            <i class="bi @(!kt.LoaiPhongBiKinLich ? "bi-check-lg" : "bi-x-lg")"></i>
                        </div>
                        <div>
                            <strong class="text-dark small">4. Kiểm soát công suất hạng phòng (Mục 8.5)</strong>
                            <div class="text-muted small" style="font-size: 0.75rem;">
                                Đã kín @kt.SoPhongDaKinLichTrongKhoang / @kt.TongPhongSanSangCuaLoai phòng thuộc loại này
                            </div>
                        </div>
                    </div>
                    <span class="badge @(!kt.LoaiPhongBiKinLich ? "bg-success" : "bg-danger")">
                        @(!kt.LoaiPhongBiKinLich ? "Còn phòng trống" : "Đã kín lịch!")
                    </span>
                </div>
            </div>

            <!-- Cảnh báo lỗi chi tiết nếu vi phạm -->
            @if (kt.DanhSachLoi.Any())
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2"><i class="bi bi-x-circle-fill me-1"></i> Không thể xác nhận đặt phòng vì:</h6>
                    <ul class="mb-0 ps-3">
                        @foreach (var err in kt.DanhSachLoi)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <!-- Form xử lý xác nhận -->
            <form asp-action="XacNhan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@dp.MaDatPhong" />

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-1"></i> Ghi chú của Lễ tân khi xử lý xác nhận:
                    </label>
                    <textarea name="ghiChuLeTan" class="letan-select w-100" rows="3" placeholder="Ví dụ: Đã đối soát thông tin khách hàng, phòng chuẩn bị sẵn sàng...">@Model.GhiChuLeTan</textarea>
                    <div class="form-text text-muted">
                        <i class="bi bi-clock me-1"></i> Ghi chú này sẽ được lưu cùng thời điểm xử lý (@DateTime.Now.ToString("dd/MM/yyyy HH:mm")).
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>

                    <div class="d-flex gap-2">
                        <a asp-action="TuChoi" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-danger px-3 rounded-pill">
                            <i class="bi bi-x-circle me-1"></i> Từ chối đơn này
                        </a>
                        @if (kt.HopLeDeXacNhan)
                        {
                            <button type="submit" class="btn btn-success px-4 py-2 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Xác nhận đặt phòng ngay
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary px-4 py-2 rounded-pill" disabled title="Không đủ điều kiện để xác nhận">
                                <i class="bi bi-shield-x me-1"></i> Không thể xác nhận (Vi phạm điều kiện)
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>