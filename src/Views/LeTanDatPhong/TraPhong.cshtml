@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình làm thủ tục trả phòng (Check-out) và tính thời gian lưu trú thực tế
*@

@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.XuLyDatPhongViewModel

@{
    ViewData["Title"] = $"Trả phòng - Đặt phòng #{Model.DatPhong.MaDatPhong}";
    var dp = Model.DatPhong;
}

<div class="container py-4" style="max-width: 800px;">
    <div class="card border-0 shadow-sm border-start border-warning border-4">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-box-arrow-left text-warning"></i> LÀM THỦ TỤC TRẢ PHÒNG (CHECK-OUT)
            </h4>
            <div class="small text-muted">
                Module 4 - Sinh viên thực hiện: Nguyễn Duy Thái (MSV: 23103100052)
            </div>
        </div>
        <div class="card-body p-4">
            <!-- Thông tin lưu trú thực tế -->
            <div class="alert alert-light border mb-4">
                <div class="row">
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Đơn đặt:</span>
                        <strong class="fs-5">#@dp.MaDatPhong</strong>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Khách hàng trả phòng:</span>
                        <strong class="fs-5 text-dark">@(dp.KhachHang?.HoTen ?? "N/A")</strong>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Phòng trả:</span>
                        <span class="badge bg-primary fs-5">Phòng @(dp.Phong?.SoPhong ?? "N/A")</span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Đã nhận phòng thực tế lúc:</span>
                        <strong class="text-primary">@(dp.NgayNhanThucTe?.ToString("dd/MM/yyyy HH:mm") ?? dp.NgayNhanPhong.ToString("dd/MM/yyyy"))</strong>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Thời điểm trả phòng thực tế ghi nhận:</span>
                        <strong class="text-success fs-5">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted">Số đêm lưu trú thực tế:</span>
                        <span class="badge bg-info text-dark fs-6">@Model.SoDem đêm</span>
                    </div>
                </div>
            </div>

            <!-- Gợi ý dịch vụ và hóa đơn (Module 5 liên kết) -->
            <div class="alert alert-info py-2 small mb-4">
                <i class="bi bi-info-circle-fill me-1"></i> Sau khi bấm <strong>Xác nhận Trả phòng</strong>, trạng thái sẽ chuyển thành <strong>Đã trả phòng</strong> và phòng sẽ được giải phóng về trạng thái <strong>Sẵn sàng</strong>. Sau đó Lễ tân có thể chuyển sang phân hệ <strong>Hóa đơn</strong> (Module 5) để tiến hành quyết toán và in hóa đơn cho khách.
            </div>

            <form asp-action="TraPhong" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@dp.MaDatPhong" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi chú kiểm tra phòng và bàn giao:</label>
                    <textarea name="ghiChu" class="form-control" rows="3" placeholder="Ví dụ: Đã kiểm tra phòng, minibar và thiết bị đầy đủ, thu hồi thẻ từ..."></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning text-dark px-4 py-2 fw-bold" onclick="return confirm('Xác nhận hoàn tất trả phòng cho đơn đặt này?');">
                        <i class="bi bi-check2-circle"></i> Xác nhận Hoàn tất Trả phòng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
