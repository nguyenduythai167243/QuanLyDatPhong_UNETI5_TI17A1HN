@{
    ViewData["Title"] = "Dashboard";
    var doanhThu = ViewBag.DoanhThuThangNay == null
        ? 0m
        : (decimal)ViewBag.DoanhThuThangNay;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tổng quan khách sạn</h2>
            <p class="text-muted mb-0">
                Tình hình hoạt động ngày @DateTime.Today.ToString("dd/MM/yyyy")
            </p>
        </div>
        <a asp-controller="ThongKe" asp-action="Index"
           class="btn btn-outline-primary mt-2">
            <i class="bi bi-bar-chart-line me-1"></i>
            Xem thống kê
        </a>
    </div>

    <div class="row g-4">
        <!-- Tổng loại phòng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng loại phòng</p>
                        <h3 class="fw-bold mb-0">@ViewBag.TongLoaiPhong</h3>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-grid fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng số phòng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng số phòng</p>
                        <h3 class="fw-bold mb-0">@ViewBag.TongSoPhong</h3>
                    </div>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Phòng sẵn sàng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Phòng sẵn sàng</p>
                        <h3 class="fw-bold mb-0">@ViewBag.PhongSanSang</h3>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng khách hàng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng khách hàng</p>
                        <h3 class="fw-bold mb-0">@ViewBag.TongKhachHang</h3>
                    </div>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng đặt phòng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng lượt đặt phòng</p>
                        <h3 class="fw-bold mb-0">@ViewBag.TongDatPhong</h3>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-calendar-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chờ xác nhận -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Chờ xác nhận</p>
                        <h3 class="fw-bold mb-0">@ViewBag.DatPhongChoXacNhan</h3>
                    </div>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đang lưu trú -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Khách đang lưu trú</p>
                        <h3 class="fw-bold mb-0">@ViewBag.KhachDangLuuTru</h3>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-person-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sắp nhận phòng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Sắp nhận phòng (7 ngày)</p>
                        <h3 class="fw-bold mb-0">@ViewBag.DatPhongSapDen</h3>
                    </div>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                        <i class="bi bi-calendar-event fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu -->
        <div class="col-12">
            <div class="card border-0 shadow-sm text-white"
                 style="background: linear-gradient(120deg, #0d6efd, #2848a8);">
                <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <p class="mb-2 opacity-75">Doanh thu tháng @DateTime.Today.ToString("MM/yyyy")</p>
                        <h2 class="fw-bold mb-2">
                            @doanhThu.ToString("N0") VNĐ
                        </h2>
                        <p class="mb-0 small opacity-75">
                            Tổng tiền các hóa đơn đã thanh toán trong tháng hiện tại
                        </p>
                    </div>
                    <i class="bi bi-wallet2 display-4 opacity-75 mt-3 mt-md-0"></i>
                </div>
            </div>
        </div>
    </div>
</div>
