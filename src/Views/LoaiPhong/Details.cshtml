@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.LoaiPhong

@{
    ViewData["Title"] = "Chi tiết loại phòng";
}

<h1>Chi tiết loại phòng</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-5">Mã loại phòng</dt>
            <dd class="col-sm-7">@Model.MaLoaiPhong</dd>

            <dt class="col-sm-5">Tên loại phòng</dt>
            <dd class="col-sm-7">@Model.TenLoaiPhong</dd>

            <dt class="col-sm-5">Mô tả</dt>
            <dd class="col-sm-7">
                @(string.IsNullOrWhiteSpace(Model.MoTa)
                    ? "Chưa có mô tả"
                    : Model.MoTa)
            </dd>

            <dt class="col-sm-5">Sức chứa tối đa</dt>
            <dd class="col-sm-7">@Model.SucChuaToiDa người</dd>

            <dt class="col-sm-5">Giá tham khảo</dt>
            <dd class="col-sm-7">
                @Model.GiaThamKhao.ToString("N0") VNĐ/đêm
            </dd>

            <dt class="col-sm-5">Trạng thái</dt>
            <dd class="col-sm-7">
                @(Model.TrangThai
                    ? "Đang hoạt động"
                    : "Ngừng hoạt động")
            </dd>
        </dl>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại danh sách
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.MaLoaiPhong"
           class="btn btn-warning">
            Sửa loại phòng
        </a>
    </div>
</div>
