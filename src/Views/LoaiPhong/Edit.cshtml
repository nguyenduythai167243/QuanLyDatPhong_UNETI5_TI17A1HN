@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.LoaiPhong

@{
    ViewData["Title"] = "Sửa loại phòng";
}

<h1>Sửa loại phòng</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.MaLoaiPhong" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="MaLoaiPhong" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenLoaiPhong" class="form-label">
                    Tên loại phòng
                </label>
                <input asp-for="TenLoaiPhong" class="form-control" />
                <span asp-validation-for="TenLoaiPhong"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label">Mô tả</label>
                <textarea asp-for="MoTa"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="MoTa"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SucChuaToiDa" class="form-label">
                    Sức chứa tối đa
                </label>
                <input asp-for="SucChuaToiDa"
                       type="number"
                       min="1"
                       class="form-control" />
                <span asp-validation-for="SucChuaToiDa"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GiaThamKhao" class="form-label">
                    Giá tham khảo (VNĐ/đêm)
                </label>
                <input asp-for="GiaThamKhao"
                       type="number"
                       min="0"
                       step="1000"
                       class="form-control" />
                <span asp-validation-for="GiaThamKhao"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="TrangThai" class="form-check-input" />
                <label asp-for="TrangThai" class="form-check-label">
                    Đang hoạt động
                </label>
            </div>

            <button type="submit" class="btn btn-primary">
                Lưu thay đổi
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
