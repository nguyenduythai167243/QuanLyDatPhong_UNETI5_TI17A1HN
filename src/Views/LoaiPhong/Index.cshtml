@model IEnumerable<QuanLyDatPhong_UNETI5_TI17A1HN.Models.LoaiPhong>

@{
    ViewData["Title"] = "Quản lý loại phòng";
}

<h1>Quản lý loại phòng</h1>


<p>Danh sách các loại phòng trong khách sạn.</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm loại phòng
    </a>
</p>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã loại phòng</th>
            <th>Tên loại phòng</th>
            <th>Mô tả</th>
            <th>Sức chứa tối đa</th>
            <th>Giá tham khảo</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var loaiPhong in Model)
            {
                <tr>
                    <td>@loaiPhong.MaLoaiPhong</td>
                    <td>@loaiPhong.TenLoaiPhong</td>
                    <td>@loaiPhong.MoTa</td>
                    <td>@loaiPhong.SucChuaToiDa</td>
                    <td>@loaiPhong.GiaThamKhao.ToString("N0") VNĐ</td>
                    <td>
                        @(loaiPhong.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@loaiPhong.MaLoaiPhong"
                           class="btn btn-warning btn-sm">
                            Sửa
                        </a>
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    Chưa có loại phòng nào.
                </td>
            </tr>
        }
    </tbody>
</table>

