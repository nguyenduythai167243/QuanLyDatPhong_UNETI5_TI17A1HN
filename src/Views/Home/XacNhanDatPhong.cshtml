@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.DatPhong

@{
    ViewData["Title"] = "Đặt Phòng Thành Công - #" + Model.MaDatPhong;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Card chúc mừng thành công -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-success text-white text-center py-5">
                    <div class="display-3 mb-2">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-1">GỬI YÊU CẦU ĐẶT PHÒNG THÀNH CÔNG!</h2>
                    <p class="mb-0 text-white-50">Cảm ơn quý khách đã tin tưởng và lựa chọn UNETI Hotel</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4 pb-3 border-bottom">
                        <span class="text-muted small text-uppercase fw-bold">Mã số đặt phòng của quý khách:</span>
                        <div class="display-5 fw-bold text-primary mt-1">#DP@Model.MaDatPhong</div>
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill mt-2">
                            <i class="bi bi-hourglass-split me-1"></i>Trạng thái: @Model.TrangThai
                        </span>
                    </div>

                    <h5 class="fw-bold text-dark mb-3">Chi Tiết Đơn Đặt Phòng:</h5>
                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Phòng:</label>
                                <strong class="fs-6 text-dark">Phòng @(Model.Phong?.SoPhong ?? "") (@(Model.Phong?.LoaiPhong?.TenLoaiPhong ?? ""))</strong>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Số lượng người:</label>
                                <strong class="fs-6 text-dark">@Model.SoNguoi Khách</strong>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Thời gian nhận phòng:</label>
                                <strong class="fs-6 text-success"><i class="bi bi-box-arrow-in-right me-1"></i>@Model.NgayNhanPhong.ToString("dd/MM/yyyy") (từ 14:00)</strong>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Thời gian trả phòng:</label>
                                <strong class="fs-6 text-danger"><i class="bi bi-box-arrow-right me-1"></i>@Model.NgayTraPhong.ToString("dd/MM/yyyy") (trước 12:00)</strong>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Người đặt phòng:</label>
                                <strong class="text-dark">@(Model.KhachHang?.HoTen ?? "")</strong>
                            </div>
                            <div class="col-sm-6">
                                <label class="text-muted small d-block">Số điện thoại liên hệ:</label>
                                <strong class="text-primary"><i class="bi bi-telephone-fill me-1"></i>@(Model.KhachHang?.SoDienThoai ?? "")</strong>
                            </div>
                            <div class="col-12 border-top pt-3 d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-dark">Tổng tiền dự kiến thanh toán:</span>
                                <h4 class="fw-bold text-primary mb-0">@Model.TongTienDuKien.ToString("N0") đ</h4>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">Quy Trình Xử Lý Tiếp Theo:</h5>
                    <div class="p-3 bg-white border rounded-3 mb-4">
                        <div class="d-flex align-items-start mb-2">
                            <div class="badge bg-primary rounded-circle p-2 me-2">1</div>
                            <div><strong>Xác nhận từ Lễ tân:</strong> Nhân viên lễ tân sẽ kiểm tra phòng và gọi điện/xác nhận đơn đặt phòng của quý khách trong vòng 15-30 phút.</div>
                        </div>
                        <div class="d-flex align-items-start mb-2">
                            <div class="badge bg-primary rounded-circle p-2 me-2">2</div>
                            <div><strong>Thủ tục Check-in:</strong> Khi đến khách sạn, quý khách vui lòng đọc <strong>Mã đặt phòng #DP@Model.MaDatPhong</strong> hoặc <strong>Số điện thoại</strong> và xuất trình CCCD gốc.</div>
                        </div>
                        <div class="d-flex align-items-start">
                            <div class="badge bg-primary rounded-circle p-2 me-2">3</div>
                            <div><strong>Thanh toán:</strong> Quý khách thanh toán tại quầy lễ tân bằng Tiền mặt hoặc Chuyển khoản QR khi nhận/trả phòng.</div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-action="TraCuu" asp-route-tuKhoa="@Model.MaDatPhong" class="btn btn-primary px-4 fw-bold shadow-sm">
                            <i class="bi bi-search me-1"></i> Theo Dõi Trạng Thái Đơn
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-house me-1"></i> Về Trang Chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
