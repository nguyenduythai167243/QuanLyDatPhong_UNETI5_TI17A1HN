@model IEnumerable<QuanLyDatPhong_UNETI5_TI17A1HN.Models.DatPhong>

@{
    ViewData["Title"] = "Lịch Sử Đặt Phòng Của Tôi";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lịch sử đặt phòng</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Đặt Phòng & Kỳ Nghỉ Của Tôi
            </h2>
        </div>
        <div>
            <a asp-action="DanhSachPhong" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Đặt Thêm Phòng Mới
            </a>
        </div>
    </div>

    @if (ViewBag.ThongBao != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>@ViewBag.ThongBao
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Phòng nghỉ</th>
                        <th>Ngày nhận</th>
                        <th>Ngày trả</th>
                        <th>Số khách</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                Bạn chưa có đơn đặt phòng nào. Hãy khám phá ngay các hạng phòng sang trọng của chúng tôi!
                                <div class="mt-3">
                                    <a asp-action="DanhSachPhong" class="btn btn-primary btn-sm">Đặt phòng ngay</a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.TrangThai switch
                            {
                                "Chờ xác nhận" => "bg-warning text-dark",
                                "Đã xác nhận" => "bg-info text-white",
                                "Đã nhận phòng" => "bg-success text-white",
                                "Đã trả phòng" => "bg-primary text-white",
                                "Đã hủy" => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="ps-3 fw-bold text-primary">#DP@item.MaDatPhong</td>
                                <td>
                                    <div><strong>Phòng @(item.Phong?.SoPhong ?? "")</strong></div>
                                    <small class="text-muted">@(item.Phong?.LoaiPhong?.TenLoaiPhong ?? "")</small>
                                </td>
                                <td><span class="text-success"><i class="bi bi-box-arrow-in-right me-1"></i>@item.NgayNhanPhong.ToString("dd/MM/yyyy")</span></td>
                                <td><span class="text-danger"><i class="bi bi-box-arrow-right me-1"></i>@item.NgayTraPhong.ToString("dd/MM/yyyy")</span></td>
                                <td><strong>@item.SoNguoi</strong> người</td>
                                <td><strong class="text-primary">@item.TongTienDuKien.ToString("N0") đ</strong></td>
                                <td><span class="badge @badgeClass px-2 py-1">@item.TrangThai</span></td>
                                <td class="text-center">
                                    <a asp-action="XacNhanDatPhong" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> Xem phiếu
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
