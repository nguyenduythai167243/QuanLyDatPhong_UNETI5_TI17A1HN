@model IEnumerable<QuanLyDatPhong_UNETI5_TI17A1HN.Models.Phong>

@{
    ViewData["Title"] = "UNETI Grand Hotel & Resort - Nghỉ Dưỡng Thượng Lưu Chuẩn 5 Sao";
    ViewData["FluidLayout"] = true;
    var loaiPhongs = ViewBag.LoaiPhongs as List<QuanLyDatPhong_UNETI5_TI17A1HN.Models.LoaiPhong> ?? new();
    var ngayNhan = ViewBag.NgayNhan as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var ngayTra = ViewBag.NgayTra as string ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var soNguoi = (int)(ViewBag.SoNguoi ?? 2);
    var maLoaiPhong = ViewBag.MaLoaiPhong as int?;
}

<div class="py-2">
    <!-- ======================================================================
         1. HERO SECTION - LUXURY MESH GRADIENT & AMBIENT ORBS
         ====================================================================== -->
    <div class="hotel-hero-wrap">
        <!-- Floating Ambient Glow Orbs -->
        <div class="hotel-hero-orb hotel-hero-orb-1"></div>
        <div class="hotel-hero-orb hotel-hero-orb-2"></div>
        <div class="hotel-hero-orb hotel-hero-orb-3"></div>

        <div class="hotel-hero-content">
            <div class="row align-items-center g-5">
                <!-- Cột trái: Tiêu đề & Giới thiệu -->
                <div class="col-lg-7">
                    <span class="hero-shine-badge">
                        <span class="hero-badge-dot"></span>
                        Khách Sạn & Nghỉ Dưỡng 5 Sao Quốc Tế
                    </span>

                    <h1 class="hero-main-title">
                        Trải Nghiệm Nghỉ Dưỡng Thượng Lưu Tại <br>
                        <span class="hero-title-gradient">UNETI Grand Hotel & Spa</span>
                    </h1>

                    <p class="hero-desc">
                        Đắm mình trong không gian kiến trúc đương đại xa hoa, dịch vụ quản gia cao cấp 24/7 và hệ sinh thái ẩm thực Michelin đỉnh cao ngay tại trung tâm thủ đô.
                    </p>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="#booking-bar" class="btn btn-warning btn-lg fw-bold px-4 py-3 rounded-pill shadow-lg text-dark d-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar2-check-fill"></i> Đặt Phòng Trực Tuyến
                        </a>
                        <a asp-action="DanhSachPhong" class="btn btn-outline-light btn-lg fw-semibold px-4 py-3 rounded-pill d-inline-flex align-items-center gap-2" style="backdrop-filter: blur(8px);">
                            <i class="bi bi-door-open"></i> Khám Phá Các Phòng
                        </a>
                    </div>

                    <!-- Hero Stats Ticker -->
                    <div class="hero-stats-row">
                        <div class="hero-stat-item">
                            <span class="hero-stat-number text-warning">50+</span>
                            <span class="hero-stat-label">Buồng phòng sang trọng</span>
                        </div>
                        <div class="hero-stat-item">
                            <span class="hero-stat-number text-info">99.8%</span>
                            <span class="hero-stat-label">Khách hàng hài lòng</span>
                        </div>
                        <div class="hero-stat-item">
                            <span class="hero-stat-number text-success">24/7</span>
                            <span class="hero-stat-label">Dịch vụ quản gia lễ tân</span>
                        </div>
                        <div class="hero-stat-item">
                            <span class="hero-stat-number text-light">5.0 ★</span>
                            <span class="hero-stat-label">Đánh giá tiêu chuẩn</span>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Floating Luxury Showcase Card -->
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="hero-floating-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-award-fill me-1"></i> Top 1 Luxury Hotel
                            </span>
                            <div class="text-warning fs-6">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                        </div>

                        <div class="text-center py-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-10 rounded-circle p-4 mb-3" style="width: 100px; height: 100px;">
                                <i class="bi bi-buildings-fill text-warning" style="font-size: 3rem;"></i>
                            </div>
                            <h3 class="fw-bold text-white mb-1">UNETI Grand Resort</h3>
                            <p class="text-white-50 small mb-0">Hương vị sang trọng & Tầm nhìn thành phố tráng lệ</p>
                        </div>

                        <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 mt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-white-50 small">Ưu đãi mùa du lịch</div>
                                    <div class="fw-bold text-warning">Giảm ngay 20% khi đặt sớm</div>
                                </div>
                                <a href="#booking-bar" class="btn btn-sm btn-light fw-bold rounded-pill px-3">
                                    Áp dụng
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================================
         2. INTERACTIVE FLOATING BOOKING CONSOLE (#booking-bar)
         ====================================================================== -->
    <div id="booking-bar" class="hotel-booking-bar-wrap">
        <div class="hotel-booking-console">
            <!-- Navigation Tabs (Click chuyển phong cách tìm kiếm) -->
            <div class="booking-nav-tabs">
                <button type="button" class="booking-nav-btn active" data-type="hotel">
                    <i class="bi bi-building"></i> Đặt Phòng Khách Sạn
                </button>
                <button type="button" class="booking-nav-btn" data-type="family">
                    <i class="bi bi-house-heart"></i> Nghỉ Dưỡng Gia Đình
                </button>
                <button type="button" class="booking-nav-btn" data-type="event">
                    <i class="bi bi-cup-hot"></i> Hội Nghị & Sự Kiện
                </button>
            </div>

            <!-- Booking Form -->
            <form asp-action="DanhSachPhong" method="get" class="row g-3 align-items-end">
                <!-- Ngày nhận -->
                <div class="col-12 col-md-3">
                    <div class="booking-input-box">
                        <label class="booking-input-label">
                            <i class="bi bi-box-arrow-in-right text-success"></i> Ngày nhận phòng
                        </label>
                        <input type="date" name="ngayNhan" value="@ngayNhan" class="booking-input-control" required />
                    </div>
                </div>

                <!-- Ngày trả -->
                <div class="col-12 col-md-3">
                    <div class="booking-input-box">
                        <label class="booking-input-label">
                            <i class="bi bi-box-arrow-left text-danger"></i> Ngày trả phòng
                        </label>
                        <input type="date" name="ngayTra" value="@ngayTra" class="booking-input-control" required />
                    </div>
                </div>

                <!-- Loại phòng -->
                <div class="col-12 col-md-2">
                    <div class="booking-input-box">
                        <label class="booking-input-label">
                            <i class="bi bi-door-closed text-primary"></i> Hạng phòng
                        </label>
                        <select name="maLoaiPhong" class="booking-input-control">
                            <option value="">Tất cả hạng</option>
                            @foreach (var lp in loaiPhongs)
                            {
                                <option value="@lp.MaLoaiPhong" selected="@(maLoaiPhong == lp.MaLoaiPhong)">@lp.TenLoaiPhong</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Số khách -->
                <div class="col-12 col-md-2">
                    <div class="booking-input-box">
                        <label class="booking-input-label">
                            <i class="bi bi-people text-info"></i> Số lượng khách
                        </label>
                        <select name="soNguoi" class="booking-input-control">
                            <option value="1" selected="@(soNguoi == 1)">1 Khách</option>
                            <option value="2" selected="@(soNguoi == 2)">2 Khách (Cặp đôi)</option>
                            <option value="3" selected="@(soNguoi == 3)">3 Khách</option>
                            <option value="4" selected="@(soNguoi == 4)">4 Khách</option>
                            <option value="6" selected="@(soNguoi >= 5)">Gia đình (> 4 khách)</option>
                        </select>
                    </div>
                </div>

                <!-- Nút tìm kiếm -->
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn-glow-luxury">
                        <i class="bi bi-search"></i>
                        <span>Tìm Phòng</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================================================================
         3. CÁC HẠNG PHÒNG NỔI BẬT & CLICK-TO-FILTER (REVEAL ANIMATION)
         ====================================================================== -->
    <div class="mb-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">
                    <i class="bi bi-gem me-1"></i> Bộ Sưu Tập Nghỉ Dưỡng
                </span>
                <h2 class="fw-bold text-dark mb-1">Các Hạng Phòng Nghỉ Đẳng Cấp</h2>
                <p class="text-muted mb-0">Tự do lựa chọn không gian hoàn mỹ với thiết kế tinh tế và view panorama đỉnh cao</p>
            </div>
            <a asp-action="DanhSachPhong" class="btn btn-outline-primary fw-bold rounded-pill px-4 py-2">
                Xem Tất Cả Phòng <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <!-- Filter Chips (Bấm lọc nhanh hiện/ẩn theo danh mục) -->
        <div class="room-filter-container">
            <button type="button" class="room-filter-chip active" data-filter="all">
                <i class="bi bi-grid-fill text-primary"></i> Tất cả các phòng
            </button>
            @foreach (var lp in loaiPhongs)
            {
                <button type="button" class="room-filter-chip" data-filter="cat-@lp.MaLoaiPhong">
                    <i class="bi bi-door-open-fill text-warning"></i> @lp.TenLoaiPhong
                </button>
            }
        </div>

        <!-- Grid Cards Phòng Nghỉ -->
        <div class="row g-4" id="room-grid">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 bg-white rounded-4 shadow-sm border">
                        <i class="bi bi-door-closed fs-1 text-muted opacity-50 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark">Hiện chưa có phòng hiển thị</h5>
                        <p class="text-muted small">Vui lòng quay lại sau hoặc liên hệ quầy lễ tân để được hỗ trợ.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var p in Model)
                {
                    var catClass = $"cat-{p.MaLoaiPhong}";
                    var roomTitle = p.LoaiPhong?.TenLoaiPhong ?? "Phòng Tiêu Chuẩn";

                    <div class="col-12 col-md-6 col-lg-4 room-card-item" data-category="@catClass">
                        <div class="hotel-room-card">
                            <!-- Visual Cover -->
                            <div class="room-visual-cover">
                                <span class="room-floor-badge">
                                    <i class="bi bi-layers-fill me-1"></i> Tầng @p.Tang
                                </span>

                                <div class="text-center z-2">
                                    <i class="bi bi-door-open-fill text-warning opacity-75" style="font-size: 3.5rem;"></i>
                                    <div class="fw-bold fs-4 text-white mt-1">Phòng @p.SoPhong</div>
                                    <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 rounded-pill px-3 py-1 small">
                                        @roomTitle
                                    </span>
                                </div>

                                <div class="room-price-float">
                                    @(p.GiaMotDem.ToString("N0")) đ <small class="text-white-50 fw-normal">/ đêm</small>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold text-dark mb-0">@roomTitle</h5>
                                        <span class="status-pill status-completed">
                                            <span class="status-dot"></span> @(string.IsNullOrEmpty(p.TrangThai) ? "Sẵn sàng" : p.TrangThai)
                                        </span>
                                    </div>

                                    <p class="text-muted small mb-3 text-truncate-2" style="min-height: 40px;">
                                        @(string.IsNullOrEmpty(p.MoTa) ? "Phòng nghỉ sang trọng, đầy đủ tiện nghi chuẩn 5 sao quốc tế, mang lại giấc ngủ trọn vẹn." : p.MoTa)
                                    </p>

                                    <!-- Thông số phòng -->
                                    <div class="row g-2 small text-muted mb-3 py-2 border-top border-bottom">
                                        <div class="col-6">
                                            <i class="bi bi-people-fill text-primary me-1"></i>Sức chứa: <strong>@p.SucChua khách</strong>
                                        </div>
                                        <div class="col-6">
                                            <i class="bi bi-arrows-angle-expand text-success me-1"></i>Diện tích: <strong>@p.DienTich m²</strong>
                                        </div>
                                        <div class="col-12 text-truncate" title="@p.TienNghi">
                                            <i class="bi bi-wifi text-info me-1"></i>Tiện ích: <strong>@(string.IsNullOrEmpty(p.TienNghi) ? "Wifi tốc độ cao, TV 4K, Minibar" : p.TienNghi)</strong>
                                        </div>
                                    </div>

                                    <!-- Nút Bấm Click Mở Rộng Tiện Ích (Interactive Reveal Tray) -->
                                    <div>
                                        <button type="button" class="room-amenities-toggle" data-target="tray-@p.MaPhong">
                                            <i class="bi bi-stars"></i> Xem nhanh tiện ích
                                        </button>
                                        <div id="tray-@p.MaPhong" class="room-amenities-tray">
                                            <div class="fw-bold text-dark mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Tiện nghi cao cấp trang bị sẵn:</div>
                                            <div class="row g-1 text-muted small">
                                                <div class="col-6"><i class="bi bi-check2"></i> Giường nệm lò xo cao cấp</div>
                                                <div class="col-6"><i class="bi bi-check2"></i> Điều hòa 2 chiều Inverter</div>
                                                <div class="col-6"><i class="bi bi-check2"></i> Smart TV Netflix & Youtube</div>
                                                <div class="col-6"><i class="bi bi-check2"></i> Máy sấy & Bàn là ủi</div>
                                                <div class="col-6"><i class="bi bi-check2"></i> Áo choàng & Khăn tắm cao cấp</div>
                                                <div class="col-6"><i class="bi bi-check2"></i> Minibar trà & cà phê miễn phí</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Nút Đặt phòng / Chi tiết -->
                                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                                    <a asp-action="ChiTietPhong" asp-route-id="@p.MaPhong" class="btn btn-outline-secondary w-50 rounded-pill fw-semibold py-2">
                                        <i class="bi bi-info-circle me-1"></i> Chi Tiết
                                    </a>
                                    <a asp-controller="DatPhong" asp-action="DatPhong" asp-route-maPhong="@p.MaPhong" asp-route-ngayNhan="@ngayNhan" asp-route-ngayTra="@ngayTra" asp-route-soNguoi="@soNguoi" class="btn btn-primary w-50 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-check2-circle"></i> Đặt Ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ======================================================================
         4. DỊCH VỤ & TIỆN ÍCH THƯỢNG LƯU (INTERACTIVE EXPERIENCE CARDS)
         ====================================================================== -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
        <div class="text-center mb-4">
            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">
                <i class="bi bi-stars me-1"></i> Dịch Vụ Thượng Lưu 5 Sao
            </span>
            <h2 class="fw-bold text-dark">Hệ Sinh Thái Tiện Ích Đỉnh Cao</h2>
            <p class="text-muted max-w-600 mx-auto">
                Chúng tôi mang lại chuỗi trải nghiệm trọn vẹn từ thể chất đến tinh thần cho kỳ nghỉ dưỡng khó quên. Nhấp chuột vào từng thẻ để khám phá chi tiết!
            </p>
        </div>

        <div class="experience-grid">
            <!-- Thẻ 1 -->
            <div class="experience-card active">
                <div class="experience-icon">
                    <i class="bi bi-water"></i>
                </div>
                <h5 class="fw-bold mb-2">Hồ Bơi Vô Cực Chân Mây</h5>
                <p class="text-muted small mb-0">
                    Tọa lạc trên tầng 25 với tầm nhìn 360 độ ngắm hoàng hôn rực rỡ, kèm quầy cocktail nhiệt đới phục vụ tận nơi.
                </p>
            </div>

            <!-- Thẻ 2 -->
            <div class="experience-card">
                <div class="experience-icon">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Sky Gourmet Restaurant</h5>
                <p class="text-muted small mb-0">
                    Thưởng thức buffet Á - Âu thượng hạng và bữa tối fine-dining tinh hoa được chế biến bởi đầu bếp chuẩn Michelin.
                </p>
            </div>

            <!-- Thẻ 3 -->
            <div class="experience-card">
                <div class="experience-icon">
                    <i class="bi bi-flower1"></i>
                </div>
                <h5 class="fw-bold mb-2">Royal Spa & Trị Liệu Thảo Mộc</h5>
                <p class="text-muted small mb-0">
                    Thư giãn tuyệt đối với liệu trình xông hơi đá muối Himalaya, massage tinh dầu hữu cơ giúp tái tạo năng lượng hoàn hảo.
                </p>
            </div>

            <!-- Thẻ 4 -->
            <div class="experience-card">
                <div class="experience-icon">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Đưa Đón Limousine & Concierge 24/7</h5>
                <p class="text-muted small mb-0">
                    Đội ngũ quản gia riêng chu đáo hỗ trợ lịch trình tham quan, đưa đón sân bay bằng dòng xe thương gia sang trọng.
                </p>
            </div>
        </div>
    </div>

    <!-- ======================================================================
         5. ĐÁNH GIÁ KHÁCH HÀNG (LUXURY TESTIMONIALS)
         ====================================================================== -->
    <div class="mb-5">
        <div class="text-center mb-5">
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">
                <i class="bi bi-chat-quote-fill me-1"></i> Cảm Nhận Khách Hàng
            </span>
            <h2 class="fw-bold text-dark">Trải Nghiệm Thật Từ Du Khách</h2>
            <p class="text-muted">Hơn 10.000+ du khách trong và ngoài nước đã tin tưởng lựa chọn UNETI Grand Hotel</p>
        </div>

        <div class="row g-4">
            <!-- Review 1 -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="d-flex align-items-center gap-1 text-warning mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-secondary small fst-italic mb-4 flex-grow-1">
                        "Kỳ nghỉ tuyệt vời nhất của gia đình mình! Phòng Suite view cực đẹp, nệm êm ái, các bạn lễ tân tiếp đón nồng hậu và làm thủ tục check-in cực kỳ nhanh chóng."
                    </p>
                    <div class="d-flex align-items-center gap-3 pt-3 border-top">
                        <div class="customer-avatar">H</div>
                        <div>
                            <div class="fw-bold text-dark">Hoàng Minh Thảo</div>
                            <div class="text-muted small">Du khách từ Hà Nội (Đã ở 3 đêm)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review 2 -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="d-flex align-items-center gap-1 text-warning mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-secondary small fst-italic mb-4 flex-grow-1">
                        "Buffet sáng quá đỗi đa dạng và ngon miệng. Khách sạn rất yên tĩnh dù nằm ngay trung tâm thành phố. Chắc chắn sẽ quay lại trong các chuyến công tác tới!"
                    </p>
                    <div class="d-flex align-items-center gap-3 pt-3 border-top">
                        <div class="customer-avatar" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">T</div>
                        <div>
                            <div class="fw-bold text-dark">Trần Đình Khang</div>
                            <div class="text-muted small">Khách doanh nhân (TP. Hồ Chí Minh)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review 3 -->
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="d-flex align-items-center gap-1 text-warning mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
