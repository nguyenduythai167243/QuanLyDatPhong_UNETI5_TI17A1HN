@model QuanLyDatPhong_UNETI5_TI17A1HN.ViewModels.DatPhongOnlineViewModel

@{
    ViewData["Title"] = "Đặt Phòng Trực Tuyến - Phòng " + (Model.Phong?.SoPhong ?? "");
    var giaMotDem = Model.Phong?.GiaMotDem ?? 0;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="DanhSachPhong">Danh sách phòng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đặt phòng</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-pencil-square text-primary me-2"></i>Hoàn Tất Thủ Tục Đặt Phòng
            </h2>
            <p class="text-muted mb-0">Vui lòng điền thông tin để chúng tôi chuẩn bị đón tiếp quý khách chu đáo nhất.</p>
        </div>
        <div>
            <a asp-action="DanhSachPhong" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Đổi Phòng Khác
            </a>
        </div>
    </div>

    <form asp-action="DatPhong" method="post" id="formDatPhong">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaPhong" />

        <div class="row g-4">
            <!-- Cột trái: Form nhập thông tin khách hàng và ngày lưu trú -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-calendar-range me-2"></i>1. Thời Gian Lưu Trú & Số Lượng Khách
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-5">
                                <label asp-for="NgayNhanPhong" class="form-label fw-bold">Ngày Nhận Phòng (Check-in) <span class="text-danger">*</span></label>
                                <input asp-for="NgayNhanPhong" id="ngayNhan" class="form-control" type="date" />
                                <span asp-validation-for="NgayNhanPhong" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="NgayTraPhong" class="form-label fw-bold">Ngày Trả Phòng (Check-out) <span class="text-danger">*</span></label>
                                <input asp-for="NgayTraPhong" id="ngayTra" class="form-control" type="date" />
                                <span asp-validation-for="NgayTraPhong" class="text-danger small"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="SoNguoi" class="form-label fw-bold">Số Người <span class="text-danger">*</span></label>
                                <input asp-for="SoNguoi" class="form-control" type="number" min="1" max="@(Model.Phong?.SucChua ?? 10)" />
                                <span asp-validation-for="SoNguoi" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-person-lines-fill me-2"></i>2. Thông Tin Người Đại Diện Đặt Phòng
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                                <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-bold">Số Điện Thoại Nhận Xác Nhận <span class="text-danger">*</span></label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoGiayToTuyThan" class="form-label fw-bold">Số CCCD / Hộ Chiếu <span class="text-danger">*</span></label>
                                <input asp-for="SoGiayToTuyThan" class="form-control" placeholder="12 số CCCD để làm thủ tục check-in" />
                                <span asp-validation-for="SoGiayToTuyThan" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Địa Chỉ Email</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="email@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-bold">Địa Chỉ</label>
                                <input asp-for="DiaChi" class="form-control" placeholder="Địa chỉ của quý khách" />
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="YeuCauDacBiet" class="form-label fw-bold">Yêu Cầu Đặc Biệt (Nếu có)</label>
                                <textarea asp-for="YeuCauDacBiet" class="form-control" rows="3" placeholder="Ví dụ: Cần phòng tầng cao, check-in sớm, có nôi em bé, v.v."></textarea>
                                <span asp-validation-for="YeuCauDacBiet" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt đơn đặt & Chi phí -->
            <div class="col-lg-4">
                <div class="card border-0 shadow rounded-4 sticky-top p-4" style="top: 20px;">
                    <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                        <i class="bi bi-receipt text-primary me-2"></i>Tóm Tắt Đặt Phòng
                    </h5>

                    @if (Model.Phong != null)
                    {
                        <div class="mb-3">
                            <span class="badge bg-primary mb-1">Phòng @Model.Phong.SoPhong</span>
                            <h5 class="fw-bold text-dark mb-1">@(Model.Phong.LoaiPhong?.TenLoaiPhong ?? "Phòng Tiêu Chuẩn")</h5>
                            <div class="small text-muted">
                                <i class="bi bi-layers me-1"></i>Tầng @Model.Phong.Tang |
                                <i class="bi bi-people me-1"></i>Tối đa @Model.Phong.SucChua khách
                            </div>
                        </div>
                    }

                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Đơn giá / đêm:</span>
                            <span class="fw-bold text-dark" id="txtDonGia">@giaMotDem.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Số đêm lưu trú:</span>
                            <span class="fw-bold text-dark" id="txtSoDem">@Model.SoDem đêm</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-bold text-dark">Tổng tiền dự kiến:</span>
                            <h4 class="fw-bold text-primary mb-0" id="txtTongTien">@Model.TongTienDuKien.ToString("N0") đ</h4>
                        </div>
                        <small class="text-muted d-block mt-1 fst-italic">* Giá đã bao gồm thuế & phí dịch vụ</small>
                    </div>

                    <div class="mb-4 small text-muted">
                        <i class="bi bi-info-circle-fill text-info me-1"></i>
                        Đơn đặt phòng sau khi gửi sẽ ở trạng thái <strong>Chờ xác nhận</strong>. Lễ tân khách sạn sẽ liên hệ xác nhận trong thời gian sớm nhất.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm text-dark">
                            <i class="bi bi-check2-circle me-1"></i> Xác Nhận Đặt Phòng
                        </button>
                        <a asp-action="DanhSachPhong" class="btn btn-outline-secondary">
                            Hủy bỏ & quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const donGia = @giaMotDem;
        const ngayNhanInput = document.getElementById('ngayNhan');
        const ngayTraInput = document.getElementById('ngayTra');
        const txtSoDem = document.getElementById('txtSoDem');
        const txtTongTien = document.getElementById('txtTongTien');

        function capNhatChiPhi() {
            if (!ngayNhanInput.value || !ngayTraInput.value) return;

            const checkIn = new Date(ngayNhanInput.value);
            const checkOut = new Date(ngayTraInput.value);

            const diffTime = checkOut.getTime() - checkIn.getTime();
            let soDem = Math.round(diffTime / (1000 * 3600 * 24));

            if (soDem < 1) soDem = 1;

            const tongTien = soDem * donGia;

            txtSoDem.innerText = soDem + " đêm";
            txtTongTien.innerText = tongTien.toLocaleString('vi-VN') + " đ";
        }

        ngayNhanInput.addEventListener('change', function() {
            // Đảm bảo ngày trả luôn sau ngày nhận ít nhất 1 ngày
            const checkIn = new Date(ngayNhanInput.value);
            const nextDay = new Date(checkIn);
            nextDay.setDate(checkIn.getDate() + 1);

            const nextDayStr = nextDay.toISOString().split('T')[0];
            if (ngayTraInput.value <= ngayNhanInput.value) {
                ngayTraInput.value = nextDayStr;
            }
            capNhatChiPhi();
        });

        ngayTraInput.addEventListener('change', capNhatChiPhi);
    </script>
}
