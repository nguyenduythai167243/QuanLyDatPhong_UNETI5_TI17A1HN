
@using QuanLyDatPhong_UNETI5_TI17A1HN.Models

@{
    ViewData["Title"] = "Lập hóa đơn";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Lập hóa đơn</h2>
        <p class="text-muted">
            Chọn đặt phòng đã trả phòng để hệ thống tính tiền tự động.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="HoaDon" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="maDatPhong" class="form-label fw-semibold">
                        Mã đặt phòng
                    </label>
                    <select id="maDatPhong" name="maDatPhong"
                            class="form-select" asp-items="ViewBag.MaDatPhong"
                            required>
                        <option value="">-- Chọn đặt phòng --</option>
                    </select>
                    <small class="text-muted">
                        Chỉ hiển thị đặt phòng đủ điều kiện lập hóa đơn.
                    </small>
                </div>

                <div class="mb-3">
                    <label for="giamGia" class="form-label fw-semibold">
                        Giảm giá (VNĐ)
                    </label>
                    <input id="giamGia" name="giamGia" type="number"
                           class="form-control" min="0" step="1000"
                           value="0" required />
                    <small class="text-muted">
                        Mức giảm giá không được vượt quá tổng tiền trước giảm giá.
                    </small>
                </div>

                <div class="mb-4">
                    <label for="hinhThucThanhToan" class="form-label fw-semibold">
                        Hình thức thanh toán
                    </label>
                    <select id="hinhThucThanhToan" name="hinhThucThanhToan"
                            class="form-select" required>
                        <option value="TienMat">Tiền mặt</option>
                        <option value="ChuyenKhoan">Chuyển khoản</option>
                        <option value="The">Thẻ</option>
                    </select>
                </div>

                <div class="alert alert-info">
                    <strong>Lưu ý:</strong> Hệ thống tự tính số đêm, tiền phòng,
                    tiền dịch vụ đã ghi nhận và tổng tiền thanh toán.
                    Hóa đơn mới được tạo ở trạng thái chưa thanh toán.
                </div>

                <button type="submit" class="btn btn-primary">
                    Lập hóa đơn
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>
