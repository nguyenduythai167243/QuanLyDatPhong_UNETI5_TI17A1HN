@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Chi tiết khách hàng</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Mã khách hàng</dt>
                <dd class="col-sm-8">@Model.MaKhachHang</dd>

                <dt class="col-sm-4">Mã tài khoản</dt>
                <dd class="col-sm-8">@Model.MaTaiKhoan</dd>

                <dt class="col-sm-4">Họ tên</dt>
                <dd class="col-sm-8">@Model.HoTen</dd>

                <dt class="col-sm-4">Ngày sinh</dt>
                <dd class="col-sm-8">
                    @(Model.NgaySinh.HasValue
                        ? Model.NgaySinh.Value.ToString("dd/MM/yyyy")
                        : "Chưa cập nhật")
                </dd>

                <dt class="col-sm-4">Giới tính</dt>
                <dd class="col-sm-8">@(Model.GioiTinh ? "Nam" : "Nữ")</dd>

                <dt class="col-sm-4">Số điện thoại</dt>
                <dd class="col-sm-8">@Model.SoDienThoai</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Địa chỉ</dt>
                <dd class="col-sm-8">@Model.DiaChi</dd>

                <dt class="col-sm-4">Số giấy tờ tùy thân</dt>
                <dd class="col-sm-8">@Model.SoGiayToTuyThan</dd>

                <dt class="col-sm-4">Quốc tịch</dt>
                <dd class="col-sm-8">@Model.QuocTich</dd>

                <dt class="col-sm-4">Trạng thái</dt>
                <dd class="col-sm-8">@Model.TrangThai</dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit"
                   asp-route-makhachhang="@Model.MaKhachHang"
                   class="btn btn-warning">Sửa thông tin</a>

                <a asp-action="Index"
                   class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>