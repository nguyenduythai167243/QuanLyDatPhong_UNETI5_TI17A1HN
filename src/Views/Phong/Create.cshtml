@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.Phong

@{
    ViewData["Title"] = "Thêm phòng mới";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý phòng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm phòng mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0 fw-bold">
                            <i class="bi bi-plus-circle me-2"></i>Thêm Mới Phòng Khách Sạn
                        </h4>
                        <small class="opacity-75">Khởi tạo thông tin phòng, thiết lập giá và tiện nghi lưu trú</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" method="post" id="createRoomForm">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                                    <strong>Vui lòng kiểm tra lại thông tin:</strong>
                                </div>
                                <div asp-validation-summary="All" class="text-danger small mb-0 ps-4"></div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Phần 1: Định danh & Loại phòng -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-info-circle text-primary me-2"></i>1. Định Danh & Loại Phòng
                        </h5>

                        <div class="row g-3 mb-4">
                            <!-- Số phòng -->
                            <div class="col-md-4">
                                <label asp-for="SoPhong" class="form-label fw-semibold">
                                    Số Phòng <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-door-closed"></i></span>
                                    <input asp-for="SoPhong" class="form-control" placeholder="VD: 101, 202, VIP01..." autofocus required />
                                </div>
                                <span asp-validation-for="SoPhong" class="text-danger small"></span>
                                <small class="text-muted">Mã số phòng không được trùng lặp</small>
                            </div>

                            <!-- Loại phòng -->
                            <div class="col-md-5">
                                <label asp-for="MaLoaiPhong" class="form-label fw-semibold">
                                    Hạng Loại Phòng <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MaLoaiPhong" class="form-select" asp-items="ViewBag.MaLoaiPhong" required>
                                    <option value="">-- Chọn loại phòng --</option>
                                </select>
                                <span asp-validation-for="MaLoaiPhong" class="text-danger small"></span>
                            </div>

                            <!-- Tầng -->
                            <div class="col-md-3">
                                <label asp-for="Tang" class="form-label fw-semibold">
                                    Tầng <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-layers"></i></span>
                                    <input asp-for="Tang" type="number" min="1" class="form-control" placeholder="VD: 1" required />
                                </div>
                                <span asp-validation-for="Tang" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Phần 2: Thông số kỹ thuật & Giá -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-cash-stack text-success me-2"></i>2. Thông Số & Giá Thuê
                        </h5>

                        <div class="row g-3 mb-4">
                            <!-- Sức chứa -->
                            <div class="col-md-4">
                                <label asp-for="SucChua" class="form-label fw-semibold">
                                    Sức Chứa Tối Đa <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                                    <input asp-for="SucChua" type="number" min="1" max="20" class="form-control" placeholder="VD: 2" required />
                                    <span class="input-group-text bg-light">người</span>
                                </div>
                                <span asp-validation-for="SucChua" class="text-danger small"></span>
                                <small class="text-muted">Không vượt quá sức chứa loại phòng</small>
                            </div>

                            <!-- Giá một đêm -->
                            <div class="col-md-4">
                                <label asp-for="GiaMotDem" class="form-label fw-semibold">
                                    Giá Một Đêm <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="GiaMotDem" type="number" min="1000" step="50000" class="form-control fw-bold text-danger" placeholder="VD: 500000" required />
                                    <span class="input-group-text bg-light fw-semibold">VNĐ</span>
                                </div>
                                <span asp-validation-for="GiaMotDem" class="text-danger small"></span>
                            </div>

                            <!-- Diện tích -->
                            <div class="col-md-4">
                                <label asp-for="DienTich" class="form-label fw-semibold">
                                    Diện Tích Phòng <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="DienTich" type="number" min="5" step="0.5" class="form-control" placeholder="VD: 25.5" required />
                                    <span class="input-group-text bg-light">m²</span>
                                </div>
                                <span asp-validation-for="DienTich" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Phần 3: Trạng thái ban đầu -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-toggles text-warning me-2"></i>3. Trạng Thái Vận Hành
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="TrangThai" class="form-label fw-semibold">
                                    Trạng Thái Ban Đầu <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TrangThai" class="form-select">
                                    <option value="Sẵn sàng" selected>✓ Sẵn sàng (Có thể đón khách ngay)</option>
                                    <option value="Đang bảo trì">⚠ Đang bảo trì (Tạm ngưng phục vụ để sửa chữa)</option>
                                    <option value="Ngừng kinh doanh">✕ Ngừng kinh doanh (Không còn đưa vào khai thác)</option>
                                </select>
                                <span asp-validation-for="TrangThai" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Phần 4: Tiện nghi & Mô tả -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-stars text-warning me-2"></i>4. Tiện Nghi & Mô Tả Phòng
                        </h5>

                        <div class="mb-3">
                            <label asp-for="TienNghi" class="form-label fw-semibold">
                                Tiện Nghi Đi Kèm <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="TienNghi" id="tienNghiInput" class="form-control" rows="2"
                                      placeholder="Ví dụ: Wifi tốc độ cao, SmartTV 55 inch, Điều hòa 2 chiều, Bồn tắm nằm, Minibar..." required></textarea>
                            <span asp-validation-for="TienNghi" class="text-danger small"></span>

                            <!-- Gợi ý tiện nghi nhanh -->
                            <div class="mt-2 d-flex flex-wrap align-items-center gap-1">
                                <small class="text-muted me-1"><i class="bi bi-lightbulb me-1"></i>Gợi ý chọn nhanh:</small>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Wifi tốc độ cao">Wifi tốc độ cao</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="SmartTV 55 inch">SmartTV 55"</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Điều hòa 2 chiều">Điều hòa 2 chiều</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Bồn tắm nằm">Bồn tắm nằm</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Ban công ngắm phố">Ban công ngắm phố</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Tủ lạnh Minibar">Minibar</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Máy sấy tóc">Máy sấy tóc</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill quick-amenity" data-amenity="Bình nóng lạnh">Bình nóng lạnh</button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-semibold">
                                Mô Tả Chi Tiết Không Gian Phòng <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="MoTa" class="form-control" rows="3"
                                      placeholder="Mô tả phong cách thiết kế, hướng cửa sổ, tiện ích bổ sung cho khách..." required></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <!-- Nút Submit & Hủy -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Hoàn Tất & Lưu Phòng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.quick-amenity').forEach(button => {
            button.addEventListener('click', function () {
                const amenity = this.getAttribute('data-amenity');
                const textarea = document.getElementById('tienNghiInput');
                let currentVal = textarea.value.trim();
                if (currentVal.length === 0) {
                    textarea.value = amenity;
                } else {
                    const list = currentVal.split(',').map(s => s.trim().toLowerCase());
                    if (!list.includes(amenity.toLowerCase())) {
                        textarea.value = currentVal + ', ' + amenity;
                    }
                }
            });
        });
    </script>
}
