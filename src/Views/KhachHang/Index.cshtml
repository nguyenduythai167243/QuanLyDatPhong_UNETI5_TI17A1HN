@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.KhachHang

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-person-circle me-2"></i>
                Thông tin cá nhân
            </h4>
        </div>

        <div class="card-body p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Mã khách hàng</label>
                <div class="col-md-8">@Model.MaKhachHang</div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Họ và tên</label>
                <div class="col-md-8">@Model.HoTen</div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Ngày sinh</label>
                <div class="col-md-8">
                    @(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Giới tính</label>
                <div class="col-md-8">
                    @(Model.GioiTinh ? "Nam" : "Nữ")
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Số điện thoại</label>
                <div class="col-md-8">
                    @(Model.SoDienThoai ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Email</label>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Địa chỉ</label>
                <div class="col-md-8">
                    @(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Số giấy tờ tùy thân</label>
                <div class="col-md-8">
                    @(Model.SoGiayToTuyThan ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Quốc tịch</label>
                <div class="col-md-8">
                    @(Model.QuocTich ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-md-4 fw-bold">Trạng thái</label>
                <div class="col-md-8">
                    @if (Model.TrangThai == "Hoạt động")
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @(Model.TrangThai ?? "Chưa cập nhật")
                        </span>
                    }
                </div>
            </div>

            <hr />

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="KhachHang"
                   asp-action="Edit"
                   class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>
                    Chỉnh sửa thông tin
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Quay về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
