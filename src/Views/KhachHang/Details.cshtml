@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.KhachHang

@{
    ViewData["Title"] = "Hồ Sơ Khách Hàng - " + Model.HoTen;
    var tongSoLanDat = (int)(ViewBag.TongSoLanDat ?? 0);
    var soLanHoanTat = (int)(ViewBag.SoLanHoanTat ?? 0);
    var soLanHuy = (int)(ViewBag.SoLanHuy ?? 0);
    var tongChiTieu = (decimal)(ViewBag.TongChiTieu ?? 0m);
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Khách Hàng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Hồ sơ #@Model.MaKhachHang</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-person-badge text-primary me-2"></i>Hồ Sơ: @Model.HoTen
            </h2>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <a asp-action="Edit" asp-route-id="@Model.MaKhachHang" class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại
            </a>
        </div>
    </div>

    <!-- Thông báo nếu có -->
    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin cá nhân -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body text-center p-4 border-bottom">
                    <div class="rounded-circle bg-primary text-white fs-1 fw-bold d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                        @(Model.HoTen.Substring(0, 1).ToUpper())
                    </div>
                    <h4 class="fw-bold mb-1">@Model.HoTen</h4>
                    <p class="text-muted mb-2">Mã Khách Hàng: <strong>#@Model.MaKhachHang</strong></p>
                    <div>
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i>Tài khoản Hoạt Động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2"><i class="bi bi-lock-fill me-1"></i>Đã Khóa / Vô hiệu hóa</span>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Thông tin định danh</h6>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Số CCCD / Hộ chiếu:</label>
                        <span class="fw-bold fs-6 text-dark">@Model.SoGiayToTuyThan</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Số điện thoại:</label>
                        <span class="fw-bold fs-6 text-primary"><i class="bi bi-telephone-fill me-1"></i>@Model.SoDienThoai</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Địa chỉ Email:</label>
                        <span class="fw-bold text-dark"><i class="bi bi-envelope-fill me-1 text-secondary"></i>@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Giới tính / Ngày sinh:</label>
                        <span class="fw-bold text-dark">
                            @(Model.GioiTinh ? "Nam" : "Nữ")
                            @(Model.NgaySinh.HasValue ? $" - {Model.NgaySinh.Value:dd/MM/yyyy}" : "")
                        </span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Quốc tịch:</label>
                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.QuocTich) ? "Việt Nam" : Model.QuocTich)</span>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small d-block">Địa chỉ liên hệ:</label>
                        <span class="fw-bold text-dark"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</span>
                    </div>
                </div>

                @if (Model.TaiKhoan != null)
                {
                    <div class="card-footer bg-light p-3">
                        <small class="text-muted d-block">Tài khoản liên kết:</small>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="fw-bold text-primary">@Model.TaiKhoan.TenDangNhap</span>
                            <span class="badge bg-secondary">@Model.TaiKhoan.VaiTro</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Thống kê chi tiêu -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-bar-chart-line-fill text-success me-2"></i>Tổng Quan Chi Tiêu & Đặt Phòng
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted">Tổng số lượt đặt phòng:</span>
                        <span class="fw-bold fs-6">@tongSoLanDat lần</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted">Đã hoàn tất lưu trú:</span>
                        <span class="fw-bold text-success">@soLanHoanTat lần</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted">Đã hủy:</span>
                        <span class="fw-bold text-danger">@soLanHuy lần</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="text-muted fw-bold">Tổng chi tiêu tích lũy:</span>
                        <span class="fw-bold fs-5 text-primary">@tongChiTieu.ToString("N0") VNĐ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Lịch sử đặt phòng của khách -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Lịch Sử Đặt Phòng (@Model.DatPhongs.Count lần)
                    </h5>
                    <a asp-controller="LeTanDatPhong" asp-action="Create" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i> Đặt Phòng Mới Cho Khách
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-3">Mã ĐP</th>
                                <th>Phòng</th>
                                <th>Thời Gian Lưu Trú</th>
                                <th>Tổng Tiền</th>
                                <th>Trạng Thái</th>
                                <th class="text-center">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DatPhongs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                        Khách hàng này chưa có đơn đặt phòng nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var dp in Model.DatPhongs.OrderByDescending(d => d.NgayDat))
                                {
                                    string badgeClass = dp.TrangThai switch
                                    {
                                        "Chờ xác nhận" => "bg-warning text-dark",
                                        "Đã xác nhận" => "bg-info text-white",
                                        "Đã nhận phòng" => "bg-success text-white",
                                        "Đã trả phòng" => "bg-primary text-white",
                                        "Đã hủy" => "bg-danger text-white",
                                        _ => "bg-secondary text-white"
                                    };

                                    <tr>
                                        <td class="ps-3 fw-bold text-primary">#@dp.MaDatPhong</td>
                                        <td>
                                            @if (dp.Phong != null)
                                            {
                                                <div><strong>Phòng @dp.Phong.SoPhong</strong></div>
                                                <small class="text-muted">@(dp.Phong.LoaiPhong?.TenLoaiPhong ?? "Loại phòng")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa gán</span>
                                            }
                                        </td>
                                        <td>
                                            <div><i class="bi bi-box-arrow-in-right text-success me-1"></i>@dp.NgayNhanPhong.ToString("dd/MM/yyyy")</div>
                                            <div><i class="bi bi-box-arrow-right text-danger me-1"></i>@dp.NgayTraPhong.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>
                                            <strong class="text-dark">@dp.TongTienDuKien.ToString("N0") đ</strong>
                                            @if (dp.HoaDon != null)
                                            {
                                                <div class="small text-success"><i class="bi bi-receipt me-1"></i>@(dp.HoaDon.TrangThai == QuanLyDatPhong_UNETI5_TI17A1HN.Models.TrangThaiTT.DaThanhToan ? "Đã thanh toán" : "Chưa thanh toán")</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass px-2 py-1">@dp.TrangThai</span>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="LeTanDatPhong" asp-action="Details" asp-route-id="@dp.MaDatPhong" class="btn btn-sm btn-outline-primary" title="Xem chi tiết đơn">
                                                <i class="bi bi-eye"></i> Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
