
@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.DichVuPhatSinh

@{
    ViewData["Title"] = "Hủy dịch vụ";
}

<div class="container py-5" style="max-width:720px">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width:76px;height:76px;background:#fff0e8;color:#d94827;font-size:30px">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h2 class="fw-bold mb-2">Xác nhận hủy dịch vụ?</h2>
            <p class="text-muted mb-4">
                Dịch vụ sẽ chuyển sang trạng thái đã hủy. Dữ liệu vẫn được giữ lại để phục vụ thống kê.
            </p>

            <div class="rounded-3 p-4 text-start mb-4" style="background:#f7f9fc">
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <span class="text-muted">Mã dịch vụ</span>
                    <strong>#DV@Model.MaDichVuPhatSinh</strong>
                </div>
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <span class="text-muted">Tên dịch vụ</span>
                    <strong>@Model.TenDichVu</strong>
                </div>
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <span class="text-muted">Mã đặt phòng</span>
                    <strong>#DP@Model.MaDatPhong</strong>
                </div>
                <div class="d-flex justify-content-between gap-3">
                    <span class="text-muted">Thành tiền</span>
                    <strong class="text-primary">@Model.ThanhTien.ToString("N0") ₫</strong>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.MaDichVuPhatSinh" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaDichVuPhatSinh" />
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4">Không, quay lại</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-x-circle me-2"></i>Xác nhận hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
