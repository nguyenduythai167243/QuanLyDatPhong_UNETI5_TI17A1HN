
@model QuanLyDatPhong_UNETI5_TI17A1HN.Models.DichVuPhatSinh

@{
    ViewData["Title"] = "Chỉnh sửa dịch vụ";
}

<div class="container py-4" style="max-width:900px">
    <a asp-action="Index" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
    </a>

    <div class="mt-3 mb-4">
        <h2 class="fw-bold">Chỉnh sửa dịch vụ</h2>
        <p class="text-muted">Cập nhật thông tin dịch vụ phát sinh.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.MaDichVuPhatSinh" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaDichVuPhatSinh" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="MaDatPhong" class="form-label fw-semibold">Mã đặt phòng</label>
                        <input asp-for="MaDatPhong" type="number" min="1" class="form-control form-control-lg" />
                        <span asp-validation-for="MaDatPhong" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TenDichVu" class="form-label fw-semibold">Tên dịch vụ</label>
                        <input asp-for="TenDichVu" class="form-control form-control-lg" />
                        <span asp-validation-for="TenDichVu" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SoLuong" class="form-label fw-semibold">Số lượng</label>
                        <input asp-for="SoLuong" type="number" min="1" class="form-control form-control-lg" />
                        <span asp-validation-for="SoLuong" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DonGia" class="form-label fw-semibold">Đơn giá (VNĐ)</label>
                        <input asp-for="DonGia" type="number" min="0" step="1000" class="form-control form-control-lg" />
                        <span asp-validation-for="DonGia" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NgaySuDung" class="form-label fw-semibold">Ngày sử dụng</label>
                        <input asp-for="NgaySuDung" type="date" class="form-control form-control-lg" />
                        <span asp-validation-for="NgaySuDung" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                        <textarea asp-for="GhiChu" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-floppy me-2"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
