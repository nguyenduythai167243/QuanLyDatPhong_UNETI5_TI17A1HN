@{
    ViewData["Title"] = "Đặt phòng";

    var quocTichHienTai = ViewBag.QuocTich as string ?? "";
    var danhSachQuocTich = new[]
    {
        "Việt Nam",
        "Trung Quốc",
        "Hàn Quốc",
        "Nhật Bản",
        "Mỹ",
        "Anh",
        "Pháp",
        "Úc",
        "Canada",
        "Singapore",
        "Thái Lan",
        "Malaysia",
        "Indonesia",
        "Ấn Độ",
        "Đức",
        "Nga",
        "Khác"
    };
}

<style>
    .booking-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    }

    .booking-title {
        text-align: center;
        color: #176b45;
        margin-bottom: 25px;
    }

    .booking-section {
        margin-bottom: 25px;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

        .booking-section h3 {
            color: #176b45;
            margin-bottom: 18px;
            font-size: 20px;
        }

    .booking-field {
        margin-bottom: 15px;
    }

        .booking-field label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .booking-field input,
        .booking-field textarea,
        .booking-field select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 15px;
        }

            .booking-field input[readonly] {
                background: #f3f4f6;
            }

    .booking-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .booking-total {
        padding: 18px;
        background: #eaf7ef;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .booking-total p {
            margin: 8px 0;
        }

    .booking-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

        .booking-buttons button,
        .booking-buttons a {
            display: inline-block;
            padding: 11px 24px;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            font-size: 15px;
        }

    .btn-book {
        background: #198754;
        color: white;
    }

        .btn-book:hover {
            background: #146c43;
        }

    .btn-cancel {
        background: #6c757d;
        color: white;
    }

        .btn-cancel:hover {
            background: #565e64;
        }

    .validation-summary,
    .field-error {
        color: #b42318;
        margin-bottom: 10px;
    }

    .field-error {
        display: block;
        font-size: 13px;
        margin-top: 5px;
    }

    .booking-message {
        padding: 12px;
        margin-bottom: 15px;
        border-radius: 6px;
        background: #eaf7ef;
        color: #176b45;
    }

    .booking-note {
        color: #666;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 600px) {
        .booking-container {
            margin: 15px;
            padding: 15px;
        }

        .booking-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="booking-container">
    <h1 class="booking-title">ĐẶT PHÒNG KHÁCH SẠN</h1>

    @if (TempData["ThongBao"] != null)
    {
        <div class="booking-message">
            @TempData["ThongBao"]
        </div>
    }

    <form asp-controller="DatPhong"
          asp-action="DatPhong"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="maPhong"
               value="@ViewBag.MaPhong" />

        <!-- 1. THÔNG TIN PHÒNG -->
        <div class="booking-section">
            <h3>1. Thông tin phòng</h3>

            <div class="booking-field">
                <label for="soPhong">Số phòng</label>
                <input id="soPhong"
                       type="text"
                       value="@ViewBag.SoPhong"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="loaiPhong">Loại phòng</label>
                <input id="loaiPhong"
                       type="text"
                       value="@ViewBag.TenLoaiPhong"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="giaPhong">Giá một đêm (VNĐ)</label>
                <input id="giaPhong"
                       type="text"
                       value="@(((decimal?)ViewBag.GiaMotDem ?? 0).ToString("N0"))"
                       readonly />
            </div>
        </div>

        <!-- 2. THÔNG TIN NGƯỜI ĐƯỢC ĐẶT PHÒNG -->
        <div class="booking-section">
            <h3>2. Thông tin người được đặt phòng</h3>

            <p class="booking-note">
                Nhập thông tin của người sẽ sử dụng phòng.
                Bạn có thể đặt phòng cho bản thân hoặc đặt hộ người khác.
                Hãy kiểm tra thông tin trước khi xác nhận.
            </p>

            <div class="booking-field">
                <label for="hoTen">Họ và tên *</label>
                <input type="text"
                       id="hoTen"
                       name="hoTen"
                       value="@ViewBag.HoTen"
                       maxlength="15"
                       placeholder="Nhập họ và tên"
                       required />

                @Html.ValidationMessage(
                    "hoTen", null, new { @class = "field-error" })
            </div>

            <div class="booking-grid">
                <div class="booking-field">
                    <label for="soDienThoai">Số điện thoại *</label>
                    <input type="tel"
                           id="soDienThoai"
                           name="soDienThoai"
                           value="@ViewBag.SoDienThoai"
                           maxlength="10"
                           placeholder="Nhập số điện thoại"
                           required />

                    @Html.ValidationMessage(
                        "soDienThoai", null, new { @class = "field-error" })
                </div>

                <div class="booking-field">
                    <label for="email">Email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           value="@ViewBag.Email"
                           maxlength="15"
                           placeholder="Nhập email" />

                    @Html.ValidationMessage(
                        "email", null, new { @class = "field-error" })
                </div>
            </div>

            <div class="booking-field">
                <label for="soGiayToTuyThan">Số giấy tờ tùy thân *</label>
                <input type="text"
                       id="soGiayToTuyThan"
                       name="soGiayToTuyThan"
                       value="@ViewBag.SoGiayToTuyThan"
                       maxlength="10"
                       placeholder="Nhập số giấy tờ tùy thân"
                       required />

                @Html.ValidationMessage(
                    "soGiayToTuyThan", null, new { @class = "field-error" })
            </div>

            <div class="booking-field">
                <label for="diaChi">Địa chỉ</label>
                <input type="text"
                       id="diaChi"
                       name="diaChi"
                       value="@ViewBag.DiaChi"
                       maxlength="20"
                       placeholder="Nhập địa chỉ" />

                @Html.ValidationMessage(
                    "diaChi", null, new { @class = "field-error" })
            </div>

            <!-- QUỐC TỊCH -->
            <div class="booking-field">
                <label for="quocTich">Quốc tịch *</label>

                <select id="quocTich"
                        name="quocTich"
                        required>
                    <option value="">-- Chọn quốc tịch --</option>

                    @foreach (var qt in danhSachQuocTich)
                    {
                        if (quocTichHienTai == qt)
                        {
                            <option value="@qt" selected>@qt</option>
                        }
                        else
                        {
                            <option value="@qt">@qt</option>
                        }
                    }
                </select>

                @Html.ValidationMessage(
                    "quocTich", null, new { @class = "field-error" })
            </div>
        </div>

        <!-- 3. THÔNG TIN ĐẶT PHÒNG -->
        <div class="booking-section">
            <h3>3. Thông tin đặt phòng</h3>

            @Html.ValidationSummary(
                false, "", new { @class = "validation-summary" })

            <div class="booking-grid">
                <div class="booking-field">
                    <label for="ngayNhanPhong">Ngày nhận phòng *</label>

                    <input type="date"
                           id="ngayNhanPhong"
                           name="ngayNhanPhong"
                           value="@ViewBag.NgayNhanPhong"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />

                    @Html.ValidationMessage(
                        "ngayNhanPhong", null, new { @class = "field-error" })
                </div>

                <div class="booking-field">
                    <label for="ngayTraPhong">Ngày trả phòng *</label>

                    <input type="date"
                           id="ngayTraPhong"
                           name="ngayTraPhong"
                           value="@ViewBag.NgayTraPhong"
                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                           required />

                    @Html.ValidationMessage(
                        "ngayTraPhong", null, new { @class = "field-error" })
                </div>
            </div>

            <div class="booking-field">
                <label for="soNguoi">Số người *</label>
                <input type="number"
                       id="soNguoi"
                       name="soNguoi"
                       value="@ViewBag.SoNguoi"
                       min="1"
                       required />

                @Html.ValidationMessage(
                    "soNguoi", null, new { @class = "field-error" })
            </div>

            <div class="booking-field">
                <label for="yeuCauDacBiet">Yêu cầu đặc biệt</label>

                <textarea id="yeuCauDacBiet"
                          name="yeuCauDacBiet"
                          rows="4"
                          maxlength="10"
                          placeholder="Ví dụ: nhận phòng muộn, cần thêm gối...">@ViewBag.YeuCauDacBiet</textarea>

                @Html.ValidationMessage(
                    "yeuCauDacBiet", null, new { @class = "field-error" })
            </div>
        </div>

        <!-- 4. CHI PHÍ DỰ KIẾN -->
        <div class="booking-total">
            <h3>Chi phí dự kiến</h3>

            <p>
                Số đêm:
                <strong id="soDem">@ViewBag.SoDem</strong>
            </p>

            <p>
                Giá một đêm:
                <strong>
                    @(((decimal?)ViewBag.GiaMotDem ?? 0).ToString("N0")) VNĐ
                </strong>
            </p>

            <p>
                Tổng tiền dự kiến:
                <strong id="tongTien">
                    @(((decimal?)ViewBag.TongTienDuKien ?? 0).ToString("N0")) VNĐ
                </strong>
            </p>

            <p class="booking-note">
                Tổng tiền dự kiến được tính theo số đêm và giá phòng.
                Giá thực tế có thể được khách sạn xác nhận lại.
            </p>
        </div>

        <!-- 5. NÚT CHỨC NĂNG -->
        <div class="booking-buttons">
            <button type="submit" class="btn-book">
                Xác nhận đặt phòng
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-cancel">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>

<script>
    const ngayNhan = document.getElementById("ngayNhanPhong");
    const ngayTra = document.getElementById("ngayTraPhong");

    const soDemElement = document.getElementById("soDem");
    const tongTienElement = document.getElementById("tongTien");

    const giaMotDem = Number(
        "@(((decimal?)ViewBag.GiaMotDem ?? 0).ToString(
                        System.Globalization.CultureInfo.InvariantCulture))"
    );

    function dinhDangTien(tien) {
        return tien.toLocaleString("vi-VN") + " VNĐ";
    }

    function tinhTien() {
        if (!ngayNhan.value || !ngayTra.value) {
            soDemElement.textContent = "0";
            tongTienElement.textContent = "0 VNĐ";
            return;
        }

        const nhan = new Date(ngayNhan.value + "T00:00:00");
        const tra = new Date(ngayTra.value + "T00:00:00");

        const soDem = Math.round(
            (tra.getTime() - nhan.getTime()) / 86400000
        );

        if (soDem <= 0) {
            soDemElement.textContent = "0";
            tongTienElement.textContent = "0 VNĐ";
            return;
        }

        soDemElement.textContent = soDem;
        tongTienElement.textContent = dinhDangTien(soDem * giaMotDem);
    }

    ngayNhan.addEventListener("change", function () {
        if (ngayNhan.value) {
            ngayTra.min = ngayNhan.value;

            if (ngayTra.value && ngayTra.value <= ngayNhan.value) {
                const ngayMoi = new Date(ngayNhan.value + "T00:00:00");
                ngayMoi.setDate(ngayMoi.getDate() + 1);

                const nam = ngayMoi.getFullYear();
                const thang = String(ngayMoi.getMonth() + 1).padStart(2, "0");
                const ngay = String(ngayMoi.getDate()).padStart(2, "0");

                ngayTra.value = `${nam}-${thang}-${ngay}`;
            }
        }

        tinhTien();
    });

    ngayTra.addEventListener("change", tinhTien);

    tinhTien();
</script>
