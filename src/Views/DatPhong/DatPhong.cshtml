
@{
    ViewData["Title"] = "Đặt phòng";

    var maPhong = ViewBag.MaPhong;
    var giaMotDem = (decimal?)ViewBag.GiaMotDem ?? 0;
}

<style>
    .booking-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    }

    .booking-title {
        text-align: center;
        color: #176b45;
        margin-bottom: 25px;
    }

    .booking-section {
        margin-bottom: 25px;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .booking-section h3 {
        color: #176b45;
        margin-bottom: 18px;
        font-size: 20px;
    }

    .booking-field {
        margin-bottom: 15px;
    }

    .booking-field label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .booking-field input,
    .booking-field textarea,
    .booking-field select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 15px;
    }

    .booking-field input[readonly] {
        background: #f3f4f6;
        color: #555;
        cursor: default;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .booking-total {
        padding: 18px;
        background: #eaf7ef;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .booking-total p {
        margin: 8px 0;
    }

    .booking-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .booking-buttons button,
    .booking-buttons a {
        display: inline-block;
        padding: 11px 24px;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        font-size: 15px;
    }

    .btn-book {
        background: #198754;
        color: white;
    }

    .btn-book:hover {
        background: #146c43;
    }

    .btn-cancel {
        background: #6c757d;
        color: white;
    }

    .btn-cancel:hover {
        background: #565e64;
    }

    .validation-summary,
    .field-error {
        color: #b42318;
        margin-bottom: 10px;
    }

    .field-error {
        display: block;
        font-size: 13px;
        margin-top: 5px;
    }

    .booking-message {
        padding: 12px;
        margin-bottom: 15px;
        border-radius: 6px;
        background: #eaf7ef;
        color: #176b45;
    }

    .booking-note {
        color: #666;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .booking-edit-link {
        color: #198754;
        font-weight: 600;
        text-decoration: none;
    }

    .booking-edit-link:hover {
        text-decoration: underline;
    }

    @@media (max-width: 600px) {
        .booking-container {
            margin: 15px;
            padding: 15px;
        }

        .booking-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="booking-container">

    <h1 class="booking-title">ĐẶT PHÒNG KHÁCH SẠN</h1>

    @if (TempData["ThongBao"] != null)
    {
        <div class="booking-message">
            @TempData["ThongBao"]
        </div>
    }

    <form asp-controller="DatPhong"
          asp-action="DatPhong"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="maPhong"
               value="@maPhong" />

        <!-- 1. THÔNG TIN PHÒNG -->
        <div class="booking-section">

            <h3>1. Thông tin phòng</h3>

            <div class="booking-field">
                <label for="soPhong">Số phòng</label>
                <input id="soPhong"
                       type="text"
                       value="@ViewBag.SoPhong"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="loaiPhong">Loại phòng</label>
                <input id="loaiPhong"
                       type="text"
                       value="@ViewBag.TenLoaiPhong"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="giaPhong">Giá một đêm (VNĐ)</label>
                <input id="giaPhong"
                       type="text"
                       value="@giaMotDem.ToString("N0")"
                       readonly />
            </div>

        </div>

        <!-- 2. THÔNG TIN CÁ NHÂN -->
        <div class="booking-section">

            <h3>2. Thông tin người đặt phòng</h3>

            <p class="booking-note">
                Thông tin được tự động lấy từ hồ sơ cá nhân của bạn.
                Bạn chỉ có thể xem thông tin tại đây.
                Nếu muốn thay đổi, vui lòng truy cập mục Thông tin cá nhân.
            </p>

            <div class="booking-field">
                <label for="hoTen">Họ và tên</label>
                <input id="hoTen"
                       type="text"
                       value="@ViewBag.HoTen"
                       readonly />
            </div>

            <div class="booking-grid">

                <div class="booking-field">
                    <label for="soDienThoai">Số điện thoại</label>
                    <input id="soDienThoai"
                           type="text"
                           value="@ViewBag.SoDienThoai"
                           readonly />
                </div>

                <div class="booking-field">
                    <label for="email">Email</label>
                    <input id="email"
                           type="text"
                           value="@ViewBag.Email"
                           readonly />
                </div>

            </div>

            <div class="booking-field">
                <label for="soGiayToTuyThan">
                    Số giấy tờ tùy thân
                </label>

                <input id="soGiayToTuyThan"
                       type="text"
                       value="@ViewBag.SoGiayToTuyThan"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="diaChi">Địa chỉ</label>

                <input id="diaChi"
                       type="text"
                       value="@ViewBag.DiaChi"
                       readonly />
            </div>

            <div class="booking-field">
                <label for="quocTich">Quốc tịch</label>

                <input id="quocTich"
                       type="text"
                       value="@ViewBag.QuocTich"
                       readonly />
            </div>

            <p class="booking-note">
                <a asp-controller="KhachHang"
                   asp-action="Edit"
                   class="booking-edit-link">
                    Chỉnh sửa thông tin cá nhân
                </a>
            </p>

        </div>

        <!-- 3. THÔNG TIN ĐẶT PHÒNG -->
        <div class="booking-section">

            <h3>3. Thông tin đặt phòng</h3>

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "validation-summary" }
            )

            <div class="booking-grid">

                <div class="booking-field">
                    <label for="ngayNhanPhong">
                        Ngày nhận phòng *
                    </label>

                    <input type="date"
                           id="ngayNhanPhong"
                           name="ngayNhanPhong"
                           value="@ViewBag.NgayNhanPhong"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />

                    @Html.ValidationMessage(
                        "ngayNhanPhong",
                        null,
                        new { @class = "field-error" }
                    )
                </div>

                <div class="booking-field">
                    <label for="ngayTraPhong">
                        Ngày trả phòng *
                    </label>

                    <input type="date"
                           id="ngayTraPhong"
                           name="ngayTraPhong"
                           value="@ViewBag.NgayTraPhong"
                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                           required />

                    @Html.ValidationMessage(
                        "ngayTraPhong",
                        null,
                        new { @class = "field-error" }
                    )
                </div>

            </div>

            <div class="booking-field">
                <label for="soNguoi">Số người *</label>

                <input type="number"
                       id="soNguoi"
                       name="soNguoi"
                       value="@ViewBag.SoNguoi"
                       min="1"
                       required />

                @Html.ValidationMessage(
                    "soNguoi",
                    null,
                    new { @class = "field-error" }
                )
            </div>

            <div class="booking-field">
                <label for="yeuCauDacBiet">
                    Yêu cầu đặc biệt
                </label>

                <textarea id="yeuCauDacBiet"
                          name="yeuCauDacBiet"
                          rows="4"
                          maxlength="10"
                          placeholder="Ví dụ: nhận phòng muộn, cần thêm gối...">@ViewBag.YeuCauDacBiet</textarea>

                @Html.ValidationMessage(
                    "yeuCauDacBiet",
                    null,
                    new { @class = "field-error" }
                )
            </div>

        </div>

        <!-- 4. CHI PHÍ DỰ KIẾN -->
        <div class="booking-total">

            <h3>Chi phí dự kiến</h3>

            <p>
                Số đêm:
                <strong id="soDem">@ViewBag.SoDem</strong>
            </p>

            <p>
                Giá một đêm:
                <strong>
                    @giaMotDem.ToString("N0") VNĐ
                </strong>
            </p>

            <p>
                Tổng tiền dự kiến:
                <strong id="tongTien">
                    @(((decimal?)ViewBag.TongTienDuKien ?? 0).ToString("N0")) VNĐ
                </strong>
            </p>

            <p class="booking-note">
                Tổng tiền dự kiến được tính theo số đêm và giá phòng.
                Giá thực tế có thể được khách sạn xác nhận lại.
            </p>

        </div>

        <!-- 5. NÚT CHỨC NĂNG -->
        <div class="booking-buttons">

            <button type="submit" class="btn-book">
                Xác nhận đặt phòng
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-cancel">
                Hủy bỏ
            </a>

        </div>

    </form>

</div>

<script>

    const ngayNhan = document.getElementById("ngayNhanPhong");
    const ngayTra = document.getElementById("ngayTraPhong");

    const soDemElement = document.getElementById("soDem");
    const tongTienElement = document.getElementById("tongTien");

    const giaMotDem = Number(
        "@giaMotDem.ToString(
            System.Globalization.CultureInfo.InvariantCulture)"
    );

    function dinhDangTien(tien) {
        return tien.toLocaleString("vi-VN") + " VNĐ";
    }

    function tinhTien() {

        if (!ngayNhan.value || !ngayTra.value) {
            soDemElement.textContent = "0";
            tongTienElement.textContent = "0 VNĐ";
            return;
        }

        const nhan = new Date(ngayNhan.value + "T00:00:00");
        const tra = new Date(ngayTra.value + "T00:00:00");

        const soDem = Math.round(
            (tra.getTime() - nhan.getTime()) / 86400000
        );

        if (soDem <= 0) {
            soDemElement.textContent = "0";
            tongTienElement.textContent = "0 VNĐ";
            return;
        }

        soDemElement.textContent = soDem;

        tongTienElement.textContent =
            dinhDangTien(soDem * giaMotDem);
    }

    ngayNhan.addEventListener("change", function () {

        if (ngayNhan.value) {

            const ngayToiThieu = new Date(
                ngayNhan.value + "T00:00:00"
            );

            ngayToiThieu.setDate(
                ngayToiThieu.getDate() + 1
            );

            const nam = ngayToiThieu.getFullYear();
            const thang = String(
                ngayToiThieu.getMonth() + 1
            ).padStart(2, "0");

            const ngay = String(
                ngayToiThieu.getDate()
            ).padStart(2, "0");

            ngayTra.min = `${nam}-${thang}-${ngay}`;

            if (ngayTra.value && ngayTra.value <= ngayNhan.value) {
                ngayTra.value = `${nam}-${thang}-${ngay}`;
            }
        }

        tinhTien();
    });

    ngayTra.addEventListener("change", tinhTien);

    tinhTien();

</script>
