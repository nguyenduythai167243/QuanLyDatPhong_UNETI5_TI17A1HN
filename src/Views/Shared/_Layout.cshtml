@{
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyDatPhong_UNETI5_TI17A1HN</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyDatPhong_UNETI5_TI17A1HN.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/letan.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hotel-home.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2 mb-3">
            <div class="container-fluid px-3 px-xl-4">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-2 shadow-sm" style="width: 36px; height: 36px;">
                        <i class="bi bi-buildings-fill fs-6"></i>
                    </span>
                    <div>
                        <span class="fs-5 fw-bold tracking-tight" style="color: #1e1b4b;">UNETI</span>
                        <span class="fs-6 fw-semibold text-primary">HOTEL</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold px-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold px-3" asp-controller="Home" asp-action="DanhSachPhong"><i class="bi bi-door-open me-1"></i>Tìm & Đặt Phòng</a>
                        </li>

                        @if (vaiTro == "Admin" || vaiTro == "LeTan" || vaiTro == "Lễ tân")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-bold px-3 d-inline-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-wide-connected text-primary"></i> Quản Lý Khách Sạn
                                </a>
                                <ul class="dropdown-menu shadow border-0 rounded-3 p-2">
                                    <li>
                                        <a class="dropdown-item fw-bold text-primary rounded-2 py-2" asp-controller="LeTanDatPhong" asp-action="Index">
                                            <i class="bi bi-calendar2-check-fill me-2 text-primary"></i>Lễ Tân Đặt Phòng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item fw-bold text-success rounded-2 py-2" asp-controller="QuanLyKhachHang" asp-action="Index">
                                            <i class="bi bi-people-fill me-2 text-success"></i>Quản Lý Khách Hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="LoaiPhong" asp-action="Index"><i class="bi bi-collection me-2"></i>Loại phòng</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="Phong" asp-action="Index"><i class="bi bi-door-closed me-2"></i>Phòng</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="DichVuPhatSinh" asp-action="Index"><i class="bi bi-bell me-2"></i>Dịch vụ phát sinh</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="HoaDon" asp-action="Index"><i class="bi bi-receipt me-2"></i>Hóa đơn</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-graph-up me-2"></i>Thống kê</a></li>
                                </ul>
                            </li>
                        }

                        @if (maTaiKhoan != null && (vaiTro == "KhachHang" || string.IsNullOrEmpty(vaiTro)))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-bold px-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>Tài Khoản
                                </a>
                                <ul class="dropdown-menu shadow border-0 rounded-3 p-2">
                                    <li>
                                        <a class="dropdown-item fw-bold text-primary rounded-2 py-2" asp-controller="KhachHang" asp-action="Index">
                                            <i class="bi bi-person-lines-fill me-2"></i>Thông Tin Cá Nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item fw-bold text-primary rounded-2 py-2" asp-controller="DatPhong" asp-action="LichSu">
                                            <i class="bi bi-clock-history me-2"></i>Lịch Sử Đặt Phòng
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (maTaiKhoan != null)
                        {
                            <li class="nav-item">
                                <div class="d-flex align-items-center gap-2 bg-light px-3 py-1 rounded-pill border">
                                    <span class="customer-avatar" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                        @(!string.IsNullOrWhiteSpace(hoTen) ? hoTen.Trim()[0].ToString().ToUpper() : "U")
                                    </span>
                                    <span class="small fw-bold text-dark">
                                        @hoTen <span class="badge bg-primary-subtle text-primary ms-1">@vaiTro</span>
                                    </span>
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Đăng xuất khỏi hệ thống">
                                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Page Body Container -->
    <div class="@(ViewData["FluidLayout"] as bool? == true ? "container-fluid px-3 px-xl-4" : "container") flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- ======================================================================
         HOTEL LUXURY 5-STAR FOOTER (UNETI GRAND HOTEL & RESORT)
         ====================================================================== -->
    <footer class="hotel-main-footer">
        <div class="container-fluid px-3 px-xl-5">
            <div class="footer-top-wrap">
                <div class="row g-4 g-lg-5 justify-content-between">
                    <!-- Cột 1: Thông tin thương hiệu & Liên hệ -->
                    <div class="col-12 col-lg-7">
                        <a asp-controller="Home" asp-action="Index" class="footer-brand-title">
                            <span class="footer-brand-logo">
                                <i class="bi bi-buildings-fill fs-5"></i>
                            </span>
                            <div>
                                <span>UNETI</span>
                                <span class="text-warning">HOTEL</span>
                            </div>
                        </a>
                        <p class="footer-brand-bio">
                            Khu nghỉ dưỡng thượng lưu chuẩn 5 sao quốc tế hàng đầu, nơi kiến tạo không gian lưu trú tinh hoa, tiện nghi xa hoa và trải nghiệm trọn vẹn từng khoảnh khắc.
                        </p>
                        <ul class="footer-contact-list">
                            <li class="footer-contact-item">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>218 Đường Lĩnh Nam, Quận Hoàng Mai, Hà Nội (Cơ sở UNETI)</span>
                            </li>
                            <li class="footer-contact-item">
                                <i class="bi bi-telephone-inbound-fill"></i>
                                <span><strong>Hotline 24/7:</strong> 1900 6868 &bull; (024) 3862 1504</span>
                            </li>
                            <li class="footer-contact-item">
                                <i class="bi bi-envelope-check-fill"></i>
                                <span><strong>Email:</strong> reservation@unetihotel.edu.vn</span>
                            </li>
                        </ul>
                        <!-- Mạng xã hội -->
                        <div class="footer-social-wrap">
                            <a href="#" class="footer-social-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="footer-social-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="footer-social-btn" title="YouTube"><i class="bi bi-youtube"></i></a>
                            <a href="#" class="footer-social-btn" title="TikTok"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>

                    <!-- Cột 2: Khám phá & Đặt phòng nhanh -->
                    <div class="col-12 col-md-5 col-lg-4">
                        <div class="footer-heading">Khám Phá</div>
                        <ul class="footer-links-list">
                            <li class="footer-link-item">
                                <a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i>Trang Chủ</a>
                            </li>
                            <li class="footer-link-item">
                                <a asp-controller="Home" asp-action="DanhSachPhong"><i class="bi bi-chevron-right"></i>Tìm & Đặt Phòng</a>
                            </li>
                            <li class="footer-link-item">
                                <a asp-controller="Home" asp-action="TraCuu"><i class="bi bi-chevron-right"></i>Tra Cứu Đơn Đặt</a>
                            </li>
                            <li class="footer-link-item">
                                <a asp-controller="Home" asp-action="DanhSachPhong" asp-route-maLoaiPhong="4"><i class="bi bi-chevron-right"></i>Hạng Suite VIP</a>
                            </li>
                            <li class="footer-link-item">
                                <a asp-controller="Home" asp-action="DanhSachPhong" asp-route-maLoaiPhong="5"><i class="bi bi-chevron-right"></i>Nghỉ Dưỡng Gia Đình</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chân trang bản quyền -->
        <div class="footer-bottom-bar">
            <div class="container-fluid px-3 px-xl-5">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div>
                        <span>&copy; 2026 <strong>UNETI Grand Hotel & Resort</strong>. Đề tài BTL Nhóm 5 - Lớp <strong>TI17A1HN</strong> - Trường Đại học Kinh tế - Kỹ thuật Công nghiệp.</span>
                    </div>
                    <div>
                        <ul class="footer-bottom-links">
                            <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                            <li><a href="javascript:void(0)">Điều khoản dịch vụ</a></li>
                            <li><a href="javascript:void(0)">Sơ đồ website</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/letan.js" asp-append-version="true"></script>
    <script src="~/js/hotel-home.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
