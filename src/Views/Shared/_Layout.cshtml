@{
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyDatPhong_UNETI5_TI17A1HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyDatPhong_UNETI5_TI17A1HN.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Hotel
                    Booking UNETI</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="DanhSachPhong"><i class="bi bi-door-open me-1"></i>Tìm & Đặt Phòng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="TraCuu"><i class="bi bi-search me-1"></i>Tra Cứu Đơn</a>
                            </li>

                            @if (vaiTro == "Admin" || vaiTro == "LeTan" || vaiTro == "Lễ tân")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i> Quản Lý Khách Sạn
                                    </a>
                                    <ul class="dropdown-menu shadow-sm">
                                        <li>
                                            <a class="dropdown-item fw-bold text-primary" asp-controller="LeTanDatPhong" asp-action="Index">
                                                <i class="bi bi-calendar2-check me-2"></i>Lễ Tân Đặt Phòng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item fw-bold text-success" asp-controller="KhachHang" asp-action="Index">
                                                <i class="bi bi-people-fill me-2"></i>Quản Lý Khách Hàng
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="LoaiPhong" asp-action="Index"><i class="bi bi-collection me-2"></i>Loại phòng</a></li>
                                        <li><a class="dropdown-item" asp-controller="Phong" asp-action="Index"><i class="bi bi-door-closed me-2"></i>Phòng</a></li>
                                        <li><a class="dropdown-item" asp-controller="DichVuPhatSinh" asp-action="Index"><i class="bi bi-bell me-2"></i>Dịch vụ phát sinh</a></li>
                                        <li><a class="dropdown-item" asp-controller="HoaDon" asp-action="Index"><i class="bi bi-receipt me-2"></i>Hóa đơn</a></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-graph-up me-2"></i>Thống kê</a></li>
                                    </ul>
                                </li>
                            }

                            @if (maTaiKhoan != null && (vaiTro == "KhachHang" || string.IsNullOrEmpty(vaiTro)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-info fw-bold" asp-controller="Home" asp-action="LichSuDatPhong">
                                        <i class="bi bi-clock-history me-1"></i>Lịch Sử Đặt Phòng
                                    </a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav align-items-sm-center">
                            @if (maTaiKhoan != null)
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">
                                        Xin chào, @hoTen (@vaiTro)
                                    </span>
                                </li>

                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - QuanLyDatPhong_UNETI5_TI17A1HN - <a asp-area="" asp-controller="Home"
                                                                  asp-action="Privacy">Privacy</a>
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
