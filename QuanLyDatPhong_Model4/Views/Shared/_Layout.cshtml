@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Giao diện Layout chính cho hệ thống quản lý đặt phòng và lưu trú
*@
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var vaiTro = session?.GetString("VaiTro") ?? "LeTan";
    var hoTen = session?.GetString("HoTen") ?? "Nguyễn Duy Thái (Lễ tân)";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Đặt Phòng Khách Sạn (Module 4)</title>
    
    <!-- Google Font & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #0b5ed7;
            --accent-color: #f59e0b;
            --dark-color: #1e293b;
            --light-bg: #f8fafc;
            --card-border: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--light-bg);
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .student-banner {
            background: linear-gradient(90deg, #1e3a8a 0%, #2563eb 50%, #0284c7 100%);
            color: #fff;
            padding: 8px 16px;
            font-size: 0.88rem;
            font-weight: 500;
        }

        .student-banner .badge {
            font-size: 0.82rem;
            padding: 5px 10px;
        }

        .navbar-custom {
            background-color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border-bottom: 1px solid var(--card-border);
        }

        .navbar-brand {
            font-weight: 700;
            color: #1e3a8a !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: #475569 !important;
            padding: 8px 14px !important;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #1d4ed8 !important;
            background-color: #eff6ff;
        }

        .card {
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            background-color: #ffffff;
        }

        .badge-status-cho-xac-nhan {
            background-color: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .badge-status-da-xac-nhan {
            background-color: #dbeafe;
            color: #1e40af;
            border: 1px solid #bfdbfe;
        }

        .badge-status-da-nhan-phong {
            background-color: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .badge-status-da-tra-phong {
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .badge-status-tu-choi {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .badge-status-da-huy {
            background-color: #f3f4f6;
            color: #6b7280;
            border: 1px solid #e5e7eb;
        }

        .badge-pulse {
            animation: pulse-animation 1.5s infinite;
        }

        @@keyframes pulse-animation {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .table th {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #64748b;
            font-weight: 600;
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
        }

        .btn-action {
            border-radius: 8px;
            font-weight: 500;
            padding: 5px 12px;
            font-size: 0.86rem;
            transition: all 0.15s ease-in-out;
        }

        footer {
            margin-top: auto;
            background-color: #ffffff;
            border-top: 1px solid var(--card-border);
            padding: 16px 0;
            font-size: 0.88rem;
        }
    </style>
</head>
<body>
    <!-- 1. Thanh tiêu đề sinh viên thực hiện Module 4 -->
    <div class="student-banner shadow-sm">
        <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill fs-5"></i>
                <span><strong>BÀI TẬP LỚN .NET CORE 10 MVC</strong> | Sinh viên: <strong class="text-warning">NGUYỄN DUY THÁI</strong></span>
                <span class="badge bg-warning text-dark">MSV: 23103100052</span>
                <span class="badge bg-light text-primary">Module 4: Quản lý Tiếp nhận & Trạng thái lưu trú</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-white-50">Chuyển vai trò test:</span>
                <a asp-controller="TaiKhoan" asp-action="ChuyenNhanhVaiTro" asp-route-vaiTro="LeTan" class="badge @(vaiTro == "LeTan" ? "bg-success" : "bg-secondary") text-decoration-none py-1 px-2">
                    <i class="bi bi-person-badge"></i> Lễ tân
                </a>
                <a asp-controller="TaiKhoan" asp-action="ChuyenNhanhVaiTro" asp-route-vaiTro="Admin" class="badge @(vaiTro == "Admin" ? "bg-danger" : "bg-secondary") text-decoration-none py-1 px-2">
                    <i class="bi bi-shield-lock"></i> Admin
                </a>
                <a asp-controller="TaiKhoan" asp-action="ChuyenNhanhVaiTro" asp-route-vaiTro="KhachHang" class="badge @(vaiTro == "KhachHang" ? "bg-info" : "bg-secondary") text-decoration-none py-1 px-2">
                    <i class="bi bi-person"></i> Khách hàng
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Navbar chính -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="DatPhong" asp-action="Index">
                    <i class="bi bi-building fs-4 text-primary"></i>
                    <span>UNETI HOTEL</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 fw-normal">Module 4</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="DatPhong" asp-action="Index">
                                <i class="bi bi-list-check me-1"></i> Danh sách đặt phòng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "KiemSoatCongSuat" ? "active" : "")" 
                               asp-controller="DatPhong" asp-action="KiemSoatCongSuat">
                                <i class="bi bi-pie-chart-fill me-1"></i> Kiểm soát công suất phòng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-semibold" asp-controller="DatPhong" asp-action="Index" asp-route-chiXemQuaHan="true">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Cảnh báo No-show
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark fs-7">@hoTen</div>
                                <span class="badge @(vaiTro == "Admin" ? "bg-danger" : vaiTro == "LeTan" ? "bg-primary" : "bg-info")" style="font-size: 0.72rem;">
                                    @vaiTro
                                </span>
                            </div>
                        </div>
                        <a asp-controller="TaiKhoan" asp-action="DangXuat" class="btn btn-outline-secondary btn-sm" title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- 3. Nội dung trang & Thông báo Flash Message -->
    <div class="container-fluid py-3 flex-grow-1 px-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-x-circle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- 4. Footer -->
    <footer class="text-muted">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>Hệ thống Quản lý Đặt phòng Khách sạn & Lưu trú</strong> - ASP.NET Core 10 MVC
            </div>
            <div>
                Người thực hiện: <strong>Nguyễn Duy Thái (23103100052)</strong> - Module 4: Tiếp nhận đặt phòng, nhận/trả phòng, quản lý trạng thái lưu trú
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
