@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Chi tiết đặt phòng, lịch sử xử lý lễ tân, dịch vụ phát sinh và hóa đơn
*@
@model QuanLyDatPhong_Model4.Models.Entities.DatPhong
@{
    ViewData["Title"] = $"Chi tiết đặt phòng #{Model.MaDatPhong}";
    bool isDangO = Model.TrangThai == "Đã nhận phòng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
        <h3 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>Chi tiết Đặt phòng #@Model.MaDatPhong
        </h3>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.TrangThai == "Chờ xác nhận")
        {
            <span class="badge badge-status-cho-xac-nhan fs-6 px-3 py-2">
                <i class="bi bi-clock-history me-1"></i>Chờ xác nhận
            </span>
            <a asp-action="XacNhan" asp-route-id="@Model.MaDatPhong" class="btn btn-warning btn-sm fw-bold">
                <i class="bi bi-shield-check me-1"></i>Duyệt / Từ chối
            </a>
        }
        else if (Model.TrangThai == "Đã xác nhận")
        {
            <span class="badge badge-status-da-xac-nhan fs-6 px-3 py-2">
                <i class="bi bi-check2-circle me-1"></i>Đã xác nhận
            </span>
            @if (DateTime.Today >= Model.NgayNhanPhong.Date)
            {
                <a asp-action="NhanPhong" asp-route-id="@Model.MaDatPhong" class="btn btn-success btn-sm fw-bold">
                    <i class="bi bi-key-fill me-1"></i>Làm thủ tục nhận phòng
                </a>
            }
        }
        else if (Model.TrangThai == "Đã nhận phòng")
        {
            <span class="badge badge-status-da-nhan-phong fs-6 px-3 py-2">
                <i class="bi bi-key-fill me-1"></i>Đang lưu trú
            </span>
            <a asp-action="TraPhong" asp-route-id="@Model.MaDatPhong" class="btn btn-primary btn-sm fw-bold">
                <i class="bi bi-box-arrow-right me-1"></i>Làm thủ tục trả phòng
            </a>
        }
        else if (Model.TrangThai == "Đã trả phòng")
        {
            <span class="badge badge-status-da-tra-phong fs-6 px-3 py-2">
                <i class="bi bi-receipt me-1"></i>Đã trả phòng & Lập hóa đơn
            </span>
        }
        else if (Model.TrangThai == "Từ chối")
        {
            <span class="badge badge-status-tu-choi fs-6 px-3 py-2">
                <i class="bi bi-x-circle me-1"></i>Từ chối
            </span>
        }
        else
        {
            <span class="badge badge-status-da-huy fs-6 px-3 py-2">
                <i class="bi bi-slash-circle me-1"></i>Đã hủy
            </span>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thông tin phòng & Khách hàng -->
    <div class="col-lg-6">
        <!-- Card 1: Khách hàng -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-person-badge-fill text-primary me-2"></i>Hồ sơ khách hàng
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Họ và tên:</span>
                        <div class="fw-bold text-dark fs-6">@Model.KhachHang?.HoTen</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Số CCCD / Hộ chiếu:</span>
                        <div class="fw-bold text-danger"><i class="bi bi-card-heading me-1"></i>@Model.KhachHang?.SoGiayToTuyThan</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Số điện thoại:</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-telephone me-1"></i>@Model.KhachHang?.SoDienThoai</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Email:</span>
                        <div class="text-dark"><i class="bi bi-envelope me-1"></i>@Model.KhachHang?.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Quốc tịch:</span>
                        <div class="text-dark">@Model.KhachHang?.QuocTich</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Địa chỉ:</span>
                        <div class="text-dark small">@Model.KhachHang?.DiaChi</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Phòng -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-door-open-fill text-primary me-2"></i>Thông tin phòng lưu trú
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3 border-bottom pb-3">
                    <div class="badge bg-dark fs-3 px-3 py-2">@Model.Phong?.SoPhong</div>
                    <div>
                        <div class="fw-bold fs-6 text-dark">@Model.Phong?.LoaiPhong?.TenLoaiPhong</div>
                        <div class="text-muted small">Tầng @Model.Phong?.Tang • Diện tích: @Model.Phong?.DienTich m²</div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Giá niêm yết:</span>
                        <span class="fw-bold text-primary">@Model.Phong?.GiaMotDem.ToString("N0") đ/đêm</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Sức chứa tối đa:</span>
                        <span>@Model.Phong?.SucChua người</span>
                    </div>
                    <div class="col-12 mt-2">
                        <span class="text-muted small d-block">Tiện nghi trang bị:</span>
                        <div class="small text-secondary">@Model.Phong?.TienNghi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Lịch trình & Dịch vụ & Hóa đơn -->
    <div class="col-lg-6">
        <!-- Card 3: Lịch trình lưu trú -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-check-fill text-primary me-2"></i>Lịch trình lưu trú & Nhật ký Lễ tân
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày nhận (Hẹn):</span>
                        <div class="fw-bold text-success">@Model.NgayNhanPhong.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày trả (Hẹn):</span>
                        <div class="fw-bold text-danger">@Model.NgayTraPhong.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày nhận thực tế:</span>
                        <div class="fw-bold text-dark">
                            @(Model.NgayNhanThucTe.HasValue ? Model.NgayNhanThucTe.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa nhận phòng")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Ngày trả thực tế:</span>
                        <div class="fw-bold text-dark">
                            @(Model.NgayTraThucTe.HasValue ? Model.NgayTraThucTe.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa trả phòng")
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <span class="text-muted small d-block">Nhật ký xử lý của Lễ tân:</span>
                    <div class="p-2 bg-light rounded border small text-dark mt-1">
                        <div><strong>Ngày xử lý:</strong> @(Model.NgayXuLy.HasValue ? Model.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa ghi nhận")</div>
                        <div class="mt-1"><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.GhiChuLeTan) ? "Không có ghi chú" : Model.GhiChuLeTan)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Dịch vụ phát sinh (Section 9.2) -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-cart-fill text-success me-2"></i>Dịch vụ phát sinh (@Model.DichVuPhatSinhs.Count)
                </h6>
                @if (isDangO)
                {
                    <button type="button" class="btn btn-outline-success btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalThemDichVu">
                        <i class="bi bi-plus-circle me-1"></i>Thêm dịch vụ
                    </button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên dịch vụ</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DichVuPhatSinhs.Any())
                            {
                                foreach (var dv in Model.DichVuPhatSinhs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@dv.TenDichVu</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">@dv.NgaySuDung.ToString("dd/MM HH:mm")</div>
                                        </td>
                                        <td class="text-center">@dv.SoLuong</td>
                                        <td class="text-end">@dv.DonGia.ToString("N0") đ</td>
                                        <td class="text-end fw-semibold text-primary">@dv.ThanhTien.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">Chưa phát sinh dịch vụ phụ nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Card 5: Hóa đơn thanh toán (Section 9.4) -->
        @if (Model.HoaDon != null)
        {
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-receipt-cutoff me-2"></i>Hóa đơn thanh toán #@Model.HoaDon.MaHoaDon
                    </h6>
                    <span class="badge bg-light text-primary fw-bold">@Model.HoaDon.TrangThai</span>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền phòng (@Model.HoaDon.SoDem đêm):</span>
                        <strong class="text-dark">@Model.HoaDon.TienPhong.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền dịch vụ:</span>
                        <strong class="text-success">@Model.HoaDon.TienDichVu.ToString("N0") đ</strong>
                    </div>
                    @if (Model.HoaDon.GiamGia > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Giảm giá:</span>
                            <strong class="text-danger">-@Model.HoaDon.GiamGia.ToString("N0") đ</strong>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">TỔNG THANH TOÁN:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.HoaDon.TongThanhToan.ToString("N0") đ</span>
                    </div>
                    <div class="text-muted small mt-2">
                        Hình thức: <strong>@Model.HoaDon.HinhThucThanhToan</strong> • Ngày lập: @Model.HoaDon.NgayLap.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal thêm nhanh dịch vụ phát sinh -->
@if (isDangO)
{
    <div class="modal fade" id="modalThemDichVu" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="ThemDichVu">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi bi-cart-plus-fill text-success me-2"></i>Ghi nhận dịch vụ phát sinh
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên dịch vụ <span class="text-danger">*</span>:</label>
                            <input type="text" name="tenDichVu" class="form-control" placeholder="Ví dụ: Giặt ủi, Nước suối, Bữa sáng..." required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Số lượng:</label>
                                <input type="number" name="soLuong" value="1" min="1" class="form-control" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Đơn giá (VNĐ):</label>
                                <input type="number" name="donGia" value="50000" min="0" step="5000" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ghi chú:</label>
                            <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú thêm nếu có..." />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success fw-bold">Ghi nhận dịch vụ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
