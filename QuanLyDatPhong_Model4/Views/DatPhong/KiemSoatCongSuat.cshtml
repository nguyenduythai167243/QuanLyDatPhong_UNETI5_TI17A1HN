@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Kiểm soát công suất phòng theo loại (LINQ) và sơ đồ hiện trạng phòng thời gian thực
*@
@model QuanLyDatPhong_Model4.Models.ViewModels.KiemSoatCongSuatViewModel
@{
    ViewData["Title"] = "Kiểm soát công suất phòng & Sơ đồ trạng thái";
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-pie-chart-fill text-primary me-2"></i>Kiểm soát công suất phòng & Sơ đồ lưu trú
        </h3>
        <p class="text-muted mb-0">Module 4 - Thống kê LINQ tỷ lệ lấp đầy theo loại phòng và giám sát hiện trạng phòng thời gian thực (Section 8.5)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<!-- Bộ lọc chọn khoảng ngày kiểm soát -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="KiemSoatCongSuat" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-calendar3 me-1"></i>Từ ngày
                </label>
                <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-calendar-check me-1"></i>Đến ngày
                </label>
                <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i>Kiểm tra công suất khoảng ngày
                </button>
            </div>
            <div class="col-md-3 text-end">
                <span class="text-muted small">Thời gian kiểm tra: <strong>@((Model.DenNgay - Model.TuNgay).Days) ngày</strong></span>
            </div>
        </form>
    </div>
</div>

<!-- Bảng Thống kê công suất theo từng Loại phòng (LINQ) -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Thống kê công suất theo Loại phòng (@Model.TuNgay.ToString("dd/MM/yyyy") - @Model.DenNgay.ToString("dd/MM/yyyy"))
        </h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Loại phòng</th>
                    <th class="text-center">Tổng số phòng</th>
                    <th class="text-center">Phòng sẵn sàng</th>
                    <th class="text-center">Bảo trì / Ngừng KD</th>
                    <th class="text-center">Đã kín lịch (LINQ)</th>
                    <th class="text-center">Còn trống</th>
                    <th style="width: 220px;">Tỷ lệ lấp đầy</th>
                    <th class="text-center">Cảnh báo công suất</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lp in Model.ThongKeLoaiPhong)
                {
                    <tr>
                        <td>
                            <strong class="text-dark">@lp.TenLoaiPhong</strong>
                        </td>
                        <td class="text-center fw-bold">@lp.TongSoPhong</td>
                        <td class="text-center text-success fw-bold">@lp.SoPhongSanSang</td>
                        <td class="text-center text-muted">@lp.SoPhongBaoTri</td>
                        <td class="text-center text-primary fw-bold">@lp.SoPhongDaCoLich</td>
                        <td class="text-center fw-bold @(lp.SoPhongConTrong == 0 ? "text-danger" : "text-success")">
                            @lp.SoPhongConTrong
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 10px;">
                                    <div class="progress-bar @(lp.TyLeLapDay >= 100 ? "bg-danger" : lp.TyLeLapDay >= 75 ? "bg-warning" : "bg-primary")" 
                                         role="progressbar" style="width: @lp.TyLeLapDay%;"></div>
                                </div>
                                <span class="small fw-bold" style="width: 45px;">@lp.TyLeLapDay%</span>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (lp.IsKinLich)
                            {
                                <span class="badge bg-danger text-white py-1 px-2">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i>HẾT PHÒNG TRỐNG
                                </span>
                            }
                            else if (lp.TyLeLapDay >= 70)
                            {
                                <span class="badge bg-warning text-dark py-1 px-2">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Sắp đầy (>70%)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">
                                    <i class="bi bi-check-circle-fill me-1"></i>Bình thường
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Sơ đồ trạng thái từng phòng thời gian thực (Room Status Board) -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Sơ đồ trạng thái phòng thời gian thực (30 phòng)
        </h6>
        <div class="d-flex flex-wrap gap-2 small">
            <span class="d-flex align-items-center gap-1"><span class="badge bg-success" style="width: 12px; height: 12px; padding: 0;">&nbsp;</span> Sẵn sàng / Trống</span>
            <span class="d-flex align-items-center gap-1"><span class="badge bg-danger" style="width: 12px; height: 12px; padding: 0;">&nbsp;</span> Đang có khách</span>
            <span class="d-flex align-items-center gap-1"><span class="badge bg-warning text-dark" style="width: 12px; height: 12px; padding: 0;">&nbsp;</span> Sắp nhận hôm nay</span>
            <span class="d-flex align-items-center gap-1"><span class="badge bg-secondary" style="width: 12px; height: 12px; padding: 0;">&nbsp;</span> Bảo trì / Ngừng KD</span>
        </div>
    </div>
    <div class="card-body">
        @for (int tang = 1; tang <= 5; tang++)
        {
            var phongsInTang = Model.SoDoPhong.Where(p => p.Tang == tang).ToList();
            <div class="mb-4">
                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                    <i class="bi bi-building me-1"></i>TẦNG @tang
                </h6>
                <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                    @foreach (var p in phongsInTang)
                    {
                        string cardBg = p.TrangThaiHienTai switch
                        {
                            "Đang có khách" => "border-danger bg-danger-subtle",
                            "Sắp nhận hôm nay" => "border-warning bg-warning-subtle",
                            "Trống" => "border-success bg-success-subtle",
                            _ => "border-secondary bg-light"
                        };

                        string badgeColor = p.TrangThaiHienTai switch
                        {
                            "Đang có khách" => "bg-danger",
                            "Sắp nhận hôm nay" => "bg-warning text-dark",
                            "Trống" => "bg-success",
                            _ => "bg-secondary"
                        };

                        <div class="col">
                            <div class="card h-100 shadow-sm border-2 @cardBg p-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="fs-5 text-dark">@p.SoPhong</strong>
                                    <span class="badge @badgeColor" style="font-size: 0.68rem;">@p.TrangThaiHienTai</span>
                                </div>
                                <div class="small text-truncate text-secondary" title="@p.TenLoaiPhong">
                                    @p.TenLoaiPhong
                                </div>
                                <div class="small fw-semibold text-primary mt-1">
                                    @p.GiaMotDem.ToString("N0") đ
                                </div>

                                @if (p.DatPhongHienTai != null)
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary-subtle small">
                                        <div class="text-truncate fw-bold text-dark">
                                            <i class="bi bi-person-fill"></i> @p.DatPhongHienTai.KhachHang?.HoTen
                                        </div>
                                        <a asp-action="Details" asp-route-id="@p.DatPhongHienTai.MaDatPhong" class="btn btn-outline-dark btn-sm py-0 px-2 mt-1 w-100" style="font-size: 0.72rem;">
                                            Xem đơn #@p.DatPhongHienTai.MaDatPhong
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
