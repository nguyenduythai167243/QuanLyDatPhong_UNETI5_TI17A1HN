@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Màn hình kiểm tra điều kiện (LINQ) và xác nhận hoặc từ chối đặt phòng
*@
@model QuanLyDatPhong_Model4.Models.ViewModels.XacNhanDatPhongViewModel
@{
    ViewData["Title"] = $"Xử lý đặt phòng #{Model.MaDatPhong}";
    var dp = Model.DatPhong;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <h3 class="fw-bold text-dark mb-0">
                    <i class="bi bi-shield-check text-warning me-2"></i>Tiếp nhận & Xử lý Đặt phòng #@Model.MaDatPhong
                </h3>
            </div>
            <span class="badge badge-status-cho-xac-nhan fs-6 px-3 py-2">
                <i class="bi bi-clock-history me-1"></i>Trạng thái: Chờ xác nhận
            </span>
        </div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin Đặt phòng & Khách hàng -->
            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>Thông tin đơn đặt
                        </h6>
                    </div>
                    <div class="card-body">
                        <!-- Khách hàng -->
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Khách hàng đặt:</span>
                            <div class="fw-bold text-dark fs-6">@dp?.KhachHang?.HoTen</div>
                            <div class="small text-secondary">
                                <div><i class="bi bi-telephone me-1"></i>SĐT: @dp?.KhachHang?.SoDienThoai</div>
                                <div><i class="bi bi-card-heading me-1"></i>CCCD: @dp?.KhachHang?.SoGiayToTuyThan</div>
                                <div><i class="bi bi-envelope me-1"></i>Email: @dp?.KhachHang?.Email</div>
                            </div>
                        </div>

                        <!-- Phòng -->
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Phòng đăng ký:</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark fs-6">@dp?.Phong?.SoPhong</span>
                                <span class="fw-semibold">@dp?.Phong?.LoaiPhong?.TenLoaiPhong</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Tầng @dp?.Phong?.Tang • Sức chứa: @dp?.Phong?.SucChua người • Giá: @dp?.Phong?.GiaMotDem.ToString("N0") đ/đêm
                            </div>
                        </div>

                        <!-- Lịch hẹn -->
                        <div class="mb-3 border-bottom pb-2">
                            <span class="text-muted small d-block">Thời gian lưu trú:</span>
                            <div class="fw-bold text-primary">
                                @dp?.NgayNhanPhong.ToString("dd/MM/yyyy") <i class="bi bi-arrow-right mx-1"></i> @dp?.NgayTraPhong.ToString("dd/MM/yyyy")
                            </div>
                            <div class="small text-secondary">
                                Tổng số đêm: <strong>@dp?.SoDemDuKien đêm</strong> • Số khách: <strong>@dp?.SoNguoi người</strong>
                            </div>
                        </div>

                        <!-- Tiền dự kiến & Yêu cầu -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Tổng tiền dự kiến:</span>
                                <span class="fs-5 fw-bold text-danger">@dp?.TongTienDuKien.ToString("N0") đ</span>
                            </div>
                            @if (!string.IsNullOrEmpty(dp?.YeuCauDacBiet))
                            {
                                <div class="p-2 bg-light rounded small border">
                                    <strong class="text-dark">Yêu cầu đặc biệt:</strong> @dp.YeuCauDacBiet
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Kết quả kiểm tra điều kiện tự động (LINQ) & Form xử lý -->
            <div class="col-md-7">
                <!-- 1. Bảng kiểm tra điều kiện hệ thống bằng LINQ (Section 8.3) -->
                <div class="card shadow-sm mb-4 border-2 @(Model.DuDieuKienXacNhan ? "border-success" : "border-warning")">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-clipboard-check-fill text-success me-2"></i>Kết quả kiểm tra điều kiện tự động (LINQ EF Core)
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush mb-0">
                            <!-- Điều kiện 1: Trạng thái phòng -->
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold text-dark">1. Trạng thái phòng</div>
                                    <div class="text-muted small">Phòng @dp?.Phong?.SoPhong phải ở trạng thái "Sẵn sàng"</div>
                                </div>
                                <div>
                                    @if (Model.PhongSanSang)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hợp lệ (Sẵn sàng)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Không hợp lệ (@dp?.Phong?.TrangThai)
                                        </span>
                                    }
                                </div>
                            </li>

                            <!-- Điều kiện 2: Khách hàng -->
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold text-dark">2. Khách hàng hoạt động</div>
                                    <div class="text-muted small">Tài khoản và hồ sơ khách hàng không bị khóa</div>
                                </div>
                                <div>
                                    @if (Model.KhachHangHoatDong)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động bình thường
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Tài khoản bị khóa
                                        </span>
                                    }
                                </div>
                            </li>

                            <!-- Điều kiện 3: Trùng lịch lưu trú (LINQ) -->
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold text-dark">3. Kiểm tra trùng lịch lưu trú</div>
                                        <div class="text-muted small">
                                            Kiểm tra LINQ: <code>NgayNhan &lt; OtherNgayTra && NgayTra &gt; OtherNgayNhan</code>
                                        </div>
                                    </div>
                                    <div>
                                        @if (!Model.CoDatPhongTrungLich)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Không bị trùng lịch
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white px-2 py-1">
                                                <i class="bi bi-exclamation-octagon-fill me-1"></i>TRÙNG LỊCH PHÒNG!
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (Model.CoDatPhongTrungLich)
                                {
                                    <div class="alert alert-danger mt-2 mb-0 py-2 small">
                                        <strong class="d-block mb-1">Các đơn đặt phòng đang bị trùng lịch với phòng này:</strong>
                                        @foreach (var trung in Model.DanhSachTrungLich)
                                        {
                                            <div class="border-top pt-1 mt-1">
                                                • Đơn <strong>#@trung.MaDatPhong</strong> (@trung.KhachHang?.HoTen): 
                                                từ @trung.NgayNhanPhong.ToString("dd/MM/yyyy") đến @trung.NgayTraPhong.ToString("dd/MM/yyyy") 
                                                - Trạng thái: <em>@trung.TrangThai</em>
                                            </div>
                                        }
                                    </div>
                                }
                            </li>

                            <!-- Điều kiện 4: Kiểm soát công suất loại phòng (Section 8.5) -->
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold text-dark">4. Công suất loại phòng</div>
                                    <div class="text-muted small">
                                        Đã đặt: @Model.SoPhongDaKinhCuaLoai / @Model.SoPhongSanSangCuaLoai phòng sẵn sàng
                                    </div>
                                </div>
                                <div>
                                    @if (!Model.LoaiPhongKinLich)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Còn phòng trống
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Loại phòng đã kín lịch 100%!
                                        </span>
                                    }
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- 2. Form quyết định của Lễ tân (Section 8.2) -->
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-pen-fill text-primary me-2"></i>Quyết định xử lý của Lễ tân
                        </h6>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="XacNhan">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="MaDatPhong" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                            <!-- Lựa chọn Quyết định -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark mb-2">Quyết định xử lý:</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check form-check-inline p-2 border rounded @(Model.DuDieuKienXacNhan ? "bg-light" : "opacity-75")">
                                        <input class="form-check-input ms-1" type="radio" asp-for="HanhDong" value="XacNhan" id="rdXacNhan" />
                                        <label class="form-check-label fw-bold text-success me-2" for="rdXacNhan">
                                            <i class="bi bi-check2-circle me-1"></i>Xác nhận đặt phòng
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline p-2 border rounded bg-light">
                                        <input class="form-check-input ms-1" type="radio" asp-for="HanhDong" value="TuChoi" id="rdTuChoi" />
                                        <label class="form-check-label fw-bold text-danger me-2" for="rdTuChoi">
                                            <i class="bi bi-x-circle me-1"></i>Từ chối đặt phòng
                                        </label>
                                    </div>
                                </div>
                                <span asp-validation-for="HanhDong" class="text-danger small"></span>
                            </div>

                            <!-- Ghi chú của Lễ tân (Section 8.2 bắt buộc) -->
                            <div class="mb-3">
                                <label asp-for="GhiChuLeTan" class="form-label fw-bold text-dark">
                                    Ghi chú lễ tân <span class="text-danger">*</span>:
                                </label>
                                <textarea asp-for="GhiChuLeTan" class="form-control" rows="3" placeholder="Nhập lý do xác nhận hoặc lý do từ chối..."></textarea>
                                <span asp-validation-for="GhiChuLeTan" class="text-danger small"></span>
                                <div class="form-text small">
                                    Thời gian xử lý sẽ được hệ thống tự động ghi nhận vào trường <code>NgayXuLy = @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</code>.
                                </div>
                            </div>

                            <!-- Nút Lưu -->
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                                <button type="submit" class="btn btn-primary fw-semibold px-4">
                                    <i class="bi bi-check2-square me-1"></i>Cập nhật kết quả
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
