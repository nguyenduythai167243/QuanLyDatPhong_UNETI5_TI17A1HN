@*
    Họ và tên: Nguyễn Duy Thái
    Mã sinh viên: 23103100052
    Nội dung thực hiện: Module 4 - Làm thủ tục nhận phòng (Check-in), kiểm tra ngày nhận phòng và ghi nhận NgayNhanThucTe
*@
@model QuanLyDatPhong_Model4.Models.Entities.DatPhong
@{
    ViewData["Title"] = $"Làm thủ tục nhận phòng #{Model.MaDatPhong}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <h3 class="fw-bold text-dark mb-0">
                    <i class="bi bi-key-fill text-success me-2"></i>Làm thủ tục nhận phòng (Check-in)
                </h3>
            </div>
            <span class="badge badge-status-da-xac-nhan fs-6 px-3 py-2">
                <i class="bi bi-check2-circle me-1"></i>Trạng thái: Đã xác nhận
            </span>
        </div>

        <div class="card shadow-sm border-top border-success border-4">
            <div class="card-body p-4">
                <div class="alert alert-success d-flex align-items-center gap-3 mb-4">
                    <i class="bi bi-person-check-fill fs-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Khách hàng đến nhận phòng</h6>
                        <div class="small">Lễ tân kiểm tra giấy tờ tùy thân của khách hàng và giao chìa khóa/thẻ từ phòng <strong>@Model.Phong?.SoPhong</strong>.</div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Thông tin khách hàng -->
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-3">Thông tin khách hàng</h6>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Họ và tên:</span>
                            <span class="fw-bold text-dark fs-6">@Model.KhachHang?.HoTen</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Số CCCD / Hộ chiếu (Đối chiếu):</span>
                            <span class="fw-bold text-danger fs-6"><i class="bi bi-card-heading me-1"></i>@Model.KhachHang?.SoGiayToTuyThan</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Số điện thoại:</span>
                            <span class="fw-semibold text-dark">@Model.KhachHang?.SoDienThoai</span>
                        </div>
                    </div>

                    <!-- Thông tin phòng & lưu trú -->
                    <div class="col-md-6">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-3">Thông tin phòng lưu trú</h6>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Phòng bàn giao:</span>
                            <span class="badge bg-dark fs-5">@Model.Phong?.SoPhong</span>
                            <span class="ms-2 fw-semibold text-primary">@Model.Phong?.LoaiPhong?.TenLoaiPhong</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Khoảng ngày lưu trú:</span>
                            <span class="fw-bold text-dark">@Model.NgayNhanPhong.ToString("dd/MM/yyyy") - @Model.NgayTraPhong.ToString("dd/MM/yyyy")</span>
                            <span class="text-muted small">(@Model.SoDemDuKien đêm)</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Số khách:</span>
                            <span class="fw-semibold text-dark">@Model.SoNguoi người</span>
                        </div>
                    </div>
                </div>

                <!-- Form thực hiện nhận phòng -->
                <form method="post" asp-action="NhanPhong">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Ghi chú bổ sung khi nhận phòng:</label>
                        <textarea name="ghiChuLeTan" class="form-control" rows="2" placeholder="Ví dụ: Đã nhận CCCD, bàn giao 02 thẻ từ phòng, khách yêu cầu dọn phòng lúc 9h..."></textarea>
                    </div>

                    <div class="p-3 bg-light rounded mb-4 border">
                        <div class="d-flex align-items-center gap-2 text-dark small">
                            <i class="bi bi-info-circle-fill text-primary"></i>
                            <div>
                                Khi nhấn <strong>"Xác nhận bàn giao phòng & Check-in"</strong>, hệ thống sẽ:
                                <ul class="mb-0 mt-1">
                                    <li>Chuyển trạng thái đơn sang <strong>"Đã nhận phòng"</strong></li>
                                    <li>Ghi nhận thời gian nhận phòng thực tế: <code>NgayNhanThucTe = @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</code></li>
                                    <li>Cho phép bắt đầu ghi nhận các dịch vụ phát sinh trong quá trình khách ở</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="bi bi-key-fill me-1"></i>Xác nhận bàn giao phòng & Check-in
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
